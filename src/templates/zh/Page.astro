---
export interface Props {
  title: string;
  lang: string;
  // noscript?: boolean;
  og?: OpenGraphData;
  metas?: { [key: string]: string };
  source?: string; // source code url on GitHub
}

let { title, og, source, lang } = Astro.props;

// keep: en, mnc, ja, zh-*. else resolve to zh
if (
  !lang ||
  (!["en", "mnc", "ja", "zh-*"].includes(lang) && !/zh-/.test(lang))
) {
  lang = "zh";
}
title = title ? `${title} | 新世界的大门` : "新世界的大门";

if (!og) {
  og = {
    title,
    description: "新世界的大门",
    url: "https://blog.xinshijiededa.men",
    type: "website",
  };
}


if (!Astro.site) {
  throw new Error("Astro.site is not defined");
}
const metas = {
  ...genOpenGraphMetas(og, Astro.site),
  ...Astro.props.metas,
  description: og.description ?? "新世界的大門 Blog",
};

import Base from "./Base.astro";
import Footer from "../zh/Footer.astro";
import { genOpenGraphMetas, type OpenGraphData } from "@/scripts/open-graph";
---

<Base title={title} metas={metas} lang={lang}>
  <div class="main">
    <slot />
  </div>
  <Footer source={source} />
</Base>

<style>
html {
  scroll-timeline: --page-timeline block;
}
body {
    background-size: 7px 7px;
    background-image: var(--bg-image);
    background-attachment: fixed;
    /* animation-name: bg-parallax; */
    /* animation-duration: 1ms;  Firefox requires this to apply the animation */
    /* animation-direction: alternate; */
    /* animation-timeline: scroll(block root); */
  }

  /* @keyframes bg-parallax {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: -210px -210px;
    }
  } */
</style>
