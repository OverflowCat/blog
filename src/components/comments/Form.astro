---
import nameGen from "@/scripts/name-gen";
import { pick } from "@/scripts/serendipity.ts";
const slug = Astro.url.pathname.replace(/^\/|\/$/g, "");
const placeholder = `${pick([
  "请洒潘江，各倾陆海云尔…",
  "矮纸斜行闲作草，晴窗细乳戏分茶…",
  "此意在人间，试听徽外三两弦…",
  "给主人留下些什么吧～",
])}

（可以使用 Markdown 和任意 HTML）`;
---

<form
  action="https://gudugada.xinshijiededa.men/comment"
  method="post"
  class="comment-form"
>
  <div class="form-group">
    <label for="user[name]">昵称 *</label>
    <input
      type="text"
      id="user[name]"
      name="user[name]"
      placeholder={nameGen()}
      required
    />
  </div>

  <div class="form-group">
    <label for="user[url]">主页链接 *</label>
    <input
      type="text"
      id="user[url]"
      name="user[url]"
      class="mono"
      placeholder="你的个人主页、博客、社交媒体等的 URL"
      required
    />
  </div>

  <div class="form-group">
    <label for="user[email]"
      ><span class="h">Email</span><span class="vert">邮箱</span>
    </label>
    <input
      type="email"
      id="user[email]"
      name="user[email]"
      class="mono"
      placeholder="公开显示"
    />
    <div class="hidden text-red-500" id="dont-fill-warning">请勿填写，会被当作 spam！</div>
  </div>

  <div class="form-group">
    <label for="message">留言 *</label>
    <textarea
      name="message"
      id="message"
      rows="6"
      placeholder={placeholder}
      style={{ fontFamily: "inherit" }}
      required></textarea>
  </div>

  <div class="form-group hidden">
    <label for="captcha">验证码，别勾选我！</label>
    <input type="checkbox" id="captcha" name="captcha" />
    <label for="slug">Slug</label>
    <input type="hidden" name="slug" value={slug} />
  </div>

  <button type="submit" class="form-button">发送</button>
  <span class="info">
    评论将在审核后显示，阁下可以在本博客的 Github 仓库的 <a
      href="https://github.com/OverflowCat/blog/pulls/app%2Foverflowcat"
      >拉取请求列表</a
    > 中查看。提交成功后会自动跳转。<br />
  </span>
</form>

<style lang="less">
  .info {
    font-size: 14.5px;
    color: #606060;
    margin-inline-start: 1rem;
    br {
      display: none;
    }
  }
  input[type="email"]:focus-within + #dont-fill-warning {
    display: block;
  }
  @media (max-width: 938px) {
    .info {
      display: block;
      br {
        display: inline;
      }
    }
  }

  @media (max-width: 638px) {
    .info > br {
      display: none;
    }
  }

  .hidden {
    display: none;
    user-select: none;
  }

  .comment-form {
    font-size: 115%;
    max-width: 100%;
    margin: 0 auto;
    padding: 20px;
  }
  .form-group {
    margin-block-end: 20px;

    label {
      display: block;
      margin-block-end: 5px;
      font-weight: bold;
      text-align: start;
      user-select: none;
      font-size: 17px;
    }

    input,
    textarea,
    [contenteditable] {
      inline-size: 100%;
      max-inline-size: 100%;
      text-orientation: mixed;
      padding: 10px;
    }

    textarea {
      resize: vertical; // Chrome 118 supports `block`
      resize: block;
      min-block-size: 180px;
      max-block-size: 500px;
    }
  }
</style>
