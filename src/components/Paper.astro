---
export interface Props {
  padding?: boolean;
  paper?: boolean;
  classes?: string[];
  [key: string]: any;
  transitionName?: string;
}

let { padding, classes, paper, transitionName, ...rest } = Astro.props;
if (classes === undefined) {
  classes = [];
}
if (padding) {
  classes?.push("padding");
}

classes = ["paper"].concat(classes)
if (paper !== false) {
  classes?.push("vpaper");
}
---

<div
  class:list={classes}
  {...rest}
  transition:animate="initial"
  transition:name={transitionName}
>
  <slot />
</div>

<style>
  .vpaper {
    @apply shadow-lg box-border;
    /* drop-shadow makes inner fixed relative to parent!
    See https://stackoverflow.com/a/52937920 */
    background-color: var(--paper-bg);
  }
  .padding {
    padding: 8px;
  }
</style>
