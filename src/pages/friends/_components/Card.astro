---
export interface Props {
	id?: string;
	title: string;
	link: string;
	/** RSS 订阅地址 */
	feed: string | false | null;
	avatar: string;
	/** 网站自己的描述 */
	desc?: string;
	/** 网站的基本功能需要 JavaScript 才能正常工作 */
	script?: boolean;
	/** 书写模式 */
	dir?: "rtl";
}

const { id, link, title, avatar, desc, feed, script, dir } = Astro.props;
const href = /^https?:\/\//i.test(link) ? link : `https://${link}`;
const hasComment = Astro.slots.has("default");

import { collect } from "@/scripts/opml-store";

feed &&
	collect({ title, href, url: feed, desc: desc ?? "" });
---

<li class="link-card" id={id}>
  <a href={href} dir={dir}>
    <div class="card-heading">
      <img class="avatar" loading="lazy" decoding="async" src={avatar} alt="" width="54" height="54" />
      <h2>{title}</h2>
      <span class="visit-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="card-kicker">
      <span class="site-address">{link.replace(/^https?:\/\//i, "")}</span>
      <span class="site-features">
        {feed && <i class="has-feed" role="img" aria-label="提供 RSS 订阅" title="提供 RSS 订阅" />}
        {script && <i class="require-js" role="img" aria-label="需要 JavaScript" title="需要 JavaScript" />}
      </span>
    </div>
    {desc && <blockquote class="quote" set:html={desc} />}
    {hasComment && <div class="comment"><slot /></div>}
  </a>
</li>

<style>
  .link-card {
    --card-border: light-dark(#171717, #55524d);
    --card-accent: light-dark(#385f83, #74a4d1);

    position: relative;
    isolation: isolate;
    display: flex;
    min-inline-size: 0;
    border: 1px solid var(--card-border);
    background: light-dark(#f7f6f2, #202020);
    color: light-dark(#111, #f4f1eb);
    list-style: none;
    text-align: start;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 280ms ease,
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .link-card:nth-child(4n + 2) {
    --card-accent: light-dark(#a12632, #ef5360);
  }

  .link-card:nth-child(4n + 3) {
    --card-accent: light-dark(#08756d, #58c5ba);
  }

  .link-card:nth-child(4n) {
    --card-accent: light-dark(#896400, #e3be54);
  }

  .link-card::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 35%,
      color-mix(in srgb, var(--card-accent) 16%, transparent) 50%,
      transparent 65%
    );
    background-size: 300% 100%;
    opacity: 0;
    pointer-events: none;
  }

  .link-card::after {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 0;
    border: 3px solid var(--card-accent);
    opacity: 0;
    pointer-events: none;
    transform: scale(0.985);
    transition:
      opacity 180ms ease,
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .link-card:is(:hover, :focus-within) {
    z-index: 1;
    background: light-dark(#fff, #272727);
    border-color: var(--card-accent);
    box-shadow:
      5px 6px 0 color-mix(in srgb, var(--card-accent) 28%, transparent),
      0 14px 28px light-dark(rgb(0 0 0 / 0.1), rgb(0 0 0 / 0.3));
    /* Keep transform independent of the view timeline's translate property. */
    transform: translateY(-4px);
  }

  .link-card:is(:hover, :focus-within)::before {
    animation: card-sheen 750ms ease-out both;
  }

  .link-card:is(:hover, :focus-within)::after {
    opacity: 1;
    transform: scale(1);
  }

  .link-card > a {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: 13rem;
    padding: clamp(0.85rem, 1.5vw, 1.25rem);
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .link-card > a:focus-visible {
    outline: 2px solid var(--card-accent);
    outline-offset: 4px;
  }

  .card-heading {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  .avatar {
    inline-size: 54px;
    block-size: 54px;
    object-fit: cover;
    border: 0;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .link-card:is(:hover, :focus-within) .avatar {
    transform: rotate(-7deg) scale(1.08);
  }

  h2 {
    margin: 0;
    color: inherit;
    font-size: 1.55rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: start;
    transition:
      color 180ms ease,
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .link-card:is(:hover, :focus-within) h2 {
    color: var(--card-accent);
    transform: translateY(-0.12rem);
  }

  .visit-arrow {
    align-self: start;
    color: var(--card-accent);
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .link-card:is(:hover, :focus-within) .visit-arrow {
    transform: translate(3px, -3px) scale(1.15);
  }

  .card-kicker {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.5rem;
    opacity: 0.66;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
    transition: opacity 220ms ease;
  }

  .link-card:is(:hover, :focus-within) .card-kicker {
    opacity: 1;
  }

  .site-address {
    min-inline-size: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .site-features {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.35rem;
    font-size: 1rem;
  }

  .has-feed {
    @apply i-mdi:rss;
  }

  .require-js {
    @apply i-ic:round-javascript;
    opacity: 0;
    transition: opacity 0.6s;
  }

  .link-card:is(:hover, :focus-within) .require-js {
    transform: scale(2) translateY(40%);
    opacity: 0.7;
  }

  .quote {
    margin: 0;
    background: light-dark(#f9f9f9, #272727);
    border-inline-start: 8px solid light-dark(#ccc, #55524d);
    padding-block: 0.2em;
    padding-inline: 6px;
    text-align: start;
    font-size: 0.9rem;
    line-height: 1.8;
    white-space: pre-line;
  }

  .comment {
    margin-block-start: auto;
    border-block-start: 1px solid light-dark(#c8c3b8, #393939);
    padding-block-start: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @keyframes card-sheen {
    from {
      background-position: 100% 0;
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      background-position: 0% 0;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .link-card,
    .link-card::after,
    .avatar,
    .visit-arrow,
    .card-kicker,
    .require-js,
    h2 {
      transition: none;
      transform: none;
    }

    .link-card:is(:hover, :focus-within),
    .link-card:is(:hover, :focus-within) .avatar,
    .link-card:is(:hover, :focus-within) .visit-arrow,
    .link-card:is(:hover, :focus-within) h2,
    .link-card:is(:hover, :focus-within) .require-js {
      transform: none;
    }

    .link-card:is(:hover, :focus-within)::before {
      animation: none;
    }
  }
</style>
