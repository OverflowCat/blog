---
import { getComments } from "@/scripts/comments";
import Form from "./Form.astro";
import "@/styles/a.less";
import Comment from "./Comment.astro";
import { _t } from "@/scripts/i18n";

export interface Props {
  slug?: string;
  lang?: string;
}

const lang = Astro.props.lang ?? "zh";
const slug = Astro.props.slug ?? Astro.url.pathname.replace(/^\/|\/$/g, "");
const comments = getComments(slug);

const t = _t(lang);
---

<div id="comments">
  <h2>{t("comments.title")}</h2>
  {
    comments.length >= 1 && (
      <section id="comment-list">
        <ul>
          {comments.map((comment) => (
            <Comment comment={comment} />
          ))}
        </ul>
      </section>
    )
  }

  <Form lang={lang} />
</div>

<style lang="less">
  #comments {
    code,
    pre,
    a {
      word-break: break-all;
    }
  }
  h2 {
    text-align: center;
  }
  #comment-list {
    margin: 1rem;
    ul {
      list-style: none;
      padding: 0;
    }
  }
</style>
