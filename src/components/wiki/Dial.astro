---
import { getEntry } from "astro:content";
import { GROUP_MAP, VARIETY_DATA } from "dial-data";
import { enWikt, wikiLink } from "@/scripts/wiki.ts";

export type Props = {
    name: string;
    head: string;
};

const { head, name } = Astro.props;
const entry = await getEntry("dial", name);
if (!entry) {
    throw new Error(`Dial map not found: ${name}`);
}
const { list, wiki } = entry.data;
// Define the grouping of dialect families and their regions (in the desired order)
// Metadata for each region: display label and Wikipedia link
const regionMeta = new Map(VARIETY_DATA.map(({ key, ...item }) => [key, item]));

const isHead = (syn: string) => syn === head;

type GroupName = keyof typeof GROUP_MAP;

function zhGroupName(region: GroupName) {
    return GROUP_MAP[region];
}

const families = new Map<GroupName, [string, string[]][]>();
for (const [key, value] of Object.entries(list)) {
    const metaData = regionMeta.get(key);
    const region = metaData?.group ?? "Other";
    if (!families.has(region as GroupName)) {
        families.set(region as GroupName, []);
    }
    families.get(region as GroupName)?.push([key, value]);
}
---

<table class="wikitable inline-auto max-inline-2xl!">
    <caption>
        <h5 class="NavHead text-1em! text-center">
            <span class="Hani" lang="zh">
                <a href={enWikt(head)} title={head}>{head}</a></span
            >的各地方言用詞
            <a href={enWikt(`Template:zh-dial-map/${wiki}`, "Map")}
                ><small>[地圖]</small></a
            >
        </h5>
    </caption>
    <thead>
        <tr>
            <th>語言</th>
            <th>地區</th>
            <th
                >詞<sup class="edit-link">
                    <a
                        href={`https://zh.wiktionary.org/w/index.php?title=Module%3AZh%2Fdata%2Fdial-syn%2F${encodeURIComponent(wiki)}&action=edit`}
                        >編</a
                    >/<a
                        href={`https://en.wiktionary.org/w/index.php?title=Module%3AZh%2Fdata%2Fdial-syn%2F${encodeURIComponent(wiki)}&action=edit`}
                        >edit</a
                    >
                </sup>
            </th>
        </tr>
    </thead>
    <tbody>
        {
            families.entries().map(([region, dialects]) => {
                return dialects.map(([key, value], idx) => {
                    const meta = regionMeta.get(key);
                    if (!meta) throw new Error(`No meta for ${key}`);
                    return (
                        <tr>
                            {region === "Formal" ? (
                                <th colspan="2">
                                    Formal
                                    <small>
                                        <a
                                            class="extiw"
                                            href={wikiLink(meta.link || "")}
                                            title={meta.link?.split(":").at(-1)}
                                        >
                                            白話文（Standard Chinese）
                                        </a>
                                    </small>
                                </th>
                            ) : (idx === 0) ? (
                                <th rowspan={dialects.length}>
                                    {zhGroupName(region)}
                                    <br />
                                    {region}
                                </th>
                            ) : null}
                            {region !== "Formal" && (
                                <td>
                                    <a
                                        href={wikiLink(meta.link || "")}
                                        title={meta.link?.split(":").at(-1)}
                                    >
                                        {meta.chinese}{" "}
                                        <small class="vert-hide">
                                            {meta.english ?? key}
                                        </small>
                                    </a>
                                </td>
                            )}
                            <td>
                                {value.map((syn: string, i: number) => (
                                    <span>
                                        {isHead(syn) ? (
                                            <strong class="selflink">
                                                {syn}
                                            </strong>
                                        ) : (
                                            <a href={enWikt(syn)} title={syn}>
                                                {syn}
                                            </a>
                                        )}
                                        {i < value.length - 1 && "、"}
                                    </span>
                                ))}
                            </td>
                        </tr>
                    );
                });
            })
        }
    </tbody>
</table>
