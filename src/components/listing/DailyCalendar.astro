---
import { getBlogPosts } from "@/scripts/post";
import SidebarHeading from "@/components/sidebar/SidebarHeading.astro";

const dailyPosts = (await getBlogPosts())
  .filter((post) => post.id.startsWith("daily/"))
  .map((post) => {
    const separator = post.data.title.indexOf(" / ");
    const date =
      separator >= 0
        ? post.data.title.slice(0, separator)
        : post.data.date.toISOString().slice(0, 10);

    return {
      href: `/${post.id}/`,
      title:
        separator >= 0
          ? post.data.title.slice(separator + 3)
          : post.data.title,
      date,
      shortDate: date.slice(5),
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 12);
---

<section class="daily-calendar" aria-labelledby="daily-calendar-title">
  <header>
    <SidebarHeading
      id="daily-calendar-title"
      prefix="开"
      suffix="见山"
    />
    <a href="/categories/daily/">日常</a>
  </header>
  <ol>
    {
      dailyPosts.map((post) => (
        <li>
          <time datetime={post.date}>{post.shortDate}</time>
          <a href={post.href}>{post.title}</a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .daily-calendar {
    margin-block-start: 1.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid light-dark(#c8c3b8, #393939);
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.75rem;
  }

  header > a {
    color: inherit;
    opacity: 0.65;
    font-size: 0.9rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-block-size: 2.65rem;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-block-end: 1px solid light-dark(#d5d0c7, #343434);
  }

  li:last-child {
    border-block-end: 0;
  }

  time {
    opacity: 0.58;
    white-space: nowrap;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  li > a {
    min-inline-size: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 1.05rem;
  }

  li > a:hover,
  li > a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
