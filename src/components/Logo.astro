---
export interface Props {
	theme?: "transparent" | "auto";
}

const theme = Astro.props.theme || "light";
const src = theme === "light" ? "/new-logo.svg" : "/logo-white.svg";
---

<div class="logowrapper">
  <img src={src} alt="新世界的大門" id="logo"/>
</div>

<style>
  #logo {
    display: block;
    margin: auto;
    block-size: 72px;
  }
  .logowrapper {
    z-index: 1000;
  }
</style>
