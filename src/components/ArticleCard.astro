---
export interface Props {
	post: CollectionEntry<"blog">;
}

import type { CollectionEntry } from "astro:content";
import { formatPostDate } from "../scripts/date";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getIconName } from "@/scripts/icons";
import { crc32base } from "@/scripts/serendipity";
import "@/styles/title.less";
import "@/styles/icon.less";

function htmlEscape(str: string) {
	return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

const { post } = Astro.props;
const { data } = post;
const { photo } = data;
let title = data.title;
if (data.series) {
	const [series, main] = title.split("：");
  if (!main || !series) throw new Error("Invalid title format. Expected 'Series: Main Title'.");
	title = `<span class="series font-semibold text-.95em rounded-md p-inline-2 p-block-1 ring-inset ring-1 transition hover:text-shadow-sm ${
		data.series === "harmony"
			? "bg-red-50/70 text-red-600 ring-red-600/10 hover:text-shadow-color-pink"
			: "bg-green-50/70 text-green-700 ring-green-600/20 hover:text-shadow-color-emerald"
	}">${htmlEscape(series)}</span> ${htmlEscape(main)}`;
} else {
	title = htmlEscape(title);
}
---

<table>
  <tr>
    <td class="content">
      <div>
        <span class="icon title-icon">
          {
            (
              <Icon
                name={
                  getIconName(post) ||
                  "ph:hash-bold"
                  // "mdi:halloween"
                }
              />
            )
          }
        </span><a
          class="title"
          transition:name={post.id}
          href={`/${post.id}/`} set:html={title} />
        {
          !data.desc && (
            <time
              class="title-date mono"
              datetime={data.date?.toISOString() || ""}
              set:html={formatPostDate(data.date)}
            />
          )
        }
      </div>
      <blockquote>
        {data.desc}
        {
          data.desc && (
            <a class="continue text-.95em select-none no-underline" href={`/${post.id}`}>
              阅读更多 →
            </a>
          )
        }
        {
          data.desc && (
            <time
              class="title-date"
              datetime={data.date?.toISOString() || ""}
              set:html={formatPostDate(data.date)}
            />
          )
        }
      </blockquote>
    </td>
    {
      photo && photo.src && !photo.hide && (
        <td class="title-img">
          <img
            class="title-img"
            loading="lazy"
            transition:name={crc32base(
              typeof photo === "string" ? photo : photo?.src
            )}
            width={photo.aspect ? photo.aspect.split(":")[0] : ""}
            height={photo.aspect ? photo.aspect.split(":")[1] : ""}
            src={photo.src}
            alt={photo.alt ? photo.alt : data.title}
          />
        </td>
      )
    }
    {
      photo?.img  && !photo.hide && (
        <td class="title-img">
          <Picture
            class="title-img"
            transition:name={crc32base(photo.img.src)}
            src={photo.img}
            alt={photo.alt ? photo.alt : data.title}
            formats={["avif", "webp", "jpg"]}
          />
        </td>
      )
    }
  </tr>
</table>

<style lang="less" is:global>
  td {
    padding: 0px;
    &.content {
      vertical-align: top;
    }
    &.title-img {
      inline-size: 175px;
      #vert:target & {
        inline-size: 0; // WTF???
      }
    }
  }
</style>
<style lang="less">
  .continue {
    margin: 0;
    margin-inline-start: 4px;
    margin-inline-end: 4px;
    color: #6d6d6d;
  }
  blockquote {
    margin-block-start: .5rem;
    margin-block-end: 6px;
    border-inline-start: 4px solid var(--hr-color);
    color: var(--blockquote-color);
    padding: 0;
    padding-inline-start: 11px;
  }
  .title-date {
    float: right;
    inset-block-end: 2px;
  }
  table {
    inline-size: 100%;
    border-collapse: collapse;
  }

  img.title-img {
    margin-inline-start: 10px;
    width: 175px;
    height: auto;
    border-radius: 4px;
  }
  @media (max-width: 650px) {
    td.title-img {
      display: none;
    }
  }
</style>
