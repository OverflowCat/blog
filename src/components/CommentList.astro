---
import { getAllComments } from "@/scripts/comments";
import { truncate } from "@/scripts/intl";
import { getBlogPosts } from "@/scripts/post";
import "@/styles/a.less";
import { render } from "astro:content";

const comments = getAllComments().slice(0, 7);
const posts = await getBlogPosts();
const slugMap = new Map(posts.map((post) => [post.id, post.data]));
function getTitle(id: string) {
  const slug = id.split("/").slice(0, -1).join("/");
  return slugMap.get(slug)?.title;
}
---

<ul id="comments">
  {
    comments.map((comment) => (
      <li>
        <strong>{comment.data.name}</strong> 在
        <date>
          {comment.data.date.getUTCMonth() + 1} 月 {comment.data.date.getUTCDay()} 日
        </date>
        评论《<a
          href={`${comment.slug}/#comment-${comment.data.id}`}
          set:text={getTitle(comment.id)}
        />》说：
        <span set:html={comment.rendered?.html ?? "……"} />
      </li>
    ))
  }
</ul>

<style is:global lang="less">
  ul#comments {
    list-style-type: none;
    padding-inline-start: 0.5em;
    li {
      display: -webkit-box;
      -webkit-box-orient: block-axis;
      -webkit-line-clamp: 4;
      overflow: hidden;
      box-sizing: content-box;
      * {
        display: inline;
        overflow: hidden;
        width: 100%;
      }
      padding-block: 0.2em;
      border-block-end: 1.8px solid var(--border-color);
      &:last-of-type {
        border-block-end: 1px solid transparent;
      }
      &:hover {
        border-block-end: 1px solid transparent;
        background-color: #e2e2e2;
      }
      transition: all 0.2s;
    }
    date {
      color: var(--text-secondary);
      font-style: italic;
    }
    a {
      border-block-end: 1.5px solid var(--link-underline-color, #777) !important;
    }
  }
</style>
