---
import "@/styles/icon.less";
import "@/styles/article.less";
import Comments from "@/components/comments/Comments.astro";
import LicenceBox from "@/components/licences/LicenceBox.astro";
import Common from "./Common.astro";
import "@shikijs/twoslash/style-rich.css";
const { frontmatter } = Astro.props;
import Bar from "@/templates/Bar.astro";
import "@/styles/form.less";
import type { Frontmatter } from "@/types";
import { getEntry } from "astro:content";
import { resolvePostId } from "@/scripts/post";
import { getCatsInfo, getTagsInfo, getCatSlug } from "@/scripts/tags";
import PhotoImage from "@/components/PhotoImage.astro";
import { resolveCover } from "@/scripts/photo-resolve";

function arrify<T>(x: T | T[]): T[] {
  return Array.isArray(x) ? x : [x];
}

const classes = frontmatter?.resizable !== false ? ["resizable"] : [];
export type Props = {
	frontmatter?: Frontmatter;
	content?: Frontmatter;
	file: string;
	url: string;
};

// 新版刊头所需的文章数据；与 Common.astro 一样以条目数据为准
const showHeader = Boolean(frontmatter && Astro.props.url !== "/about");
const id = resolvePostId(Astro.props.url ?? Astro.props.file ?? Astro.url.pathname);
const entry = showHeader ? (await getEntry("blog", id))?.data : undefined;
if (showHeader && !entry) {
  throw new Error(`Post ${id} not found.`);
}
const cats = entry ? arrify(entry.categories) : [];
const tags = entry ? arrify(entry.tags) : [];
const cover = entry ? resolveCover(entry) : undefined;
const licence = entry?.licence ?? "CcByNc";
const dateLabel = entry
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(entry.date)
  : "";
const mncFallback = entry?.lang === "mnc" ? "zh" : undefined;
---

{Astro.locals.renderer === 'rss' ?
  <Common layoutProps={Astro.props}></Common>
  <slot />
:
<style is:global is:inline>
  :root {
    --text-tag: light-dark(#111, #f2f0eb);
    --bg-tag: light-dark(#e3ded1, #2e2e2e);
    --bg-tag-hover: light-dark(#d8d2c1, #3a3a3a);
    --bg-tag-active: light-dark(#cbc4af, #454545);
    --accent-yellow: light-dark(#dd2f3e, #dd2f3e);
  }

  body {
    background: light-dark(#f2f2f2, #171717);
    color: light-dark(#111, #f2f0eb);
    font-family:
      "IBM Plex Sans", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei",
      system-ui, sans-serif;
  }

  .article-card {
    margin-inline: auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    inline-size: 64rem;
    max-inline-size: calc(100dvi - 2rem);
    min-inline-size: 320px;
    background: light-dark(#fff, #242424);
  }

  .article-card.no-paper {
    background: transparent;
  }

  @container html (max-inline-size: 560px) {
    .resizable {
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 100%;
    }
  }

  /* === 刊头 === */

  .article-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 2.5rem;
    padding-block-end: 1.25rem;
    border-block-end: 2px solid currentColor;
  }

  @container html (min-inline-size: 760px) {
    html:not(#vert:target) .article-head {
      grid-template-columns: minmax(0, 1fr) 11.5rem;
      align-items: end;
    }

    html:not(#vert:target) .article-head .head-kicker {
      grid-column: 1 / -1;
    }

    html:not(#vert:target) .article-head .head-meta {
      grid-column: 2;
      grid-row: 2 / span 2;
    }
  }

  .head-kicker {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .head-kicker .kicker-cat {
    min-inline-size: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.66;
  }

  .head-kicker time {
    flex: none;
    white-space: nowrap;
    opacity: 0.66;
  }

  .article-head h1 {
    margin: 0;
    font-family: inherit;
    font-size: clamp(1.9rem, 1rem + 3.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    text-align: start;
    overflow-wrap: anywhere;
  }

  .standfirst {
    margin: 0;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem);
    line-height: 1.6;
    opacity: 0.75;
    text-align: start;
  }

  .head-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .meta-row {
    display: flex;
    gap: 0.6rem;
  }

  .meta-label {
    flex: none;
    font-weight: 700;
    opacity: 0.55;
  }

  .meta-values {
    min-inline-size: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
  }

  .head-meta a {
    padding-inline: 0.15rem;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }

  .head-meta a sup {
    opacity: 0.55;
    font-weight: 400;
  }

  .head-meta a:hover,
  .head-meta a:focus-visible,
  .head-kicker a:hover,
  .head-kicker a:focus-visible {
    background: var(--accent-yellow);
    color: #111;
    opacity: 1;
  }

  /* === 封面 === */

  .article-card .cover {
    position: relative;
  }

  .article-card .cover:first-child {
    margin-block-start: calc(-1 * clamp(1.25rem, 3vw, 2.5rem));
    margin-inline: calc(-1 * clamp(1.25rem, 3vw, 2.5rem));
  }

  .article-card .cover #cover {
    border-radius: 0;
  }

  .cover-cat {
    position: absolute;
    inset-block-start: 0.65rem;
    inset-inline-start: 0.65rem;
    max-inline-size: calc(100% - 1.3rem);
    padding: 0.35rem 0.5rem;
    overflow: hidden;
    background: #111d;
    color: #fff;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 750;
    line-height: 1;
  }

  /* === 正文黄色强调 === */

  .article-card ::selection {
    background: var(--accent-yellow);
    color: #111;
  }

  .article-card article#post h2 {
    border-inline-start: 0.35rem solid var(--accent-yellow);
    padding-inline-start: 0.6rem;
  }

  .article-card article#post blockquote {
    border-inline-start-color: var(--accent-yellow);
  }

  /* === 评论区 === */

  section#comments {
    margin-block: 1rem;
  }

  .comments-card h2 {
    margin: 0;
    padding-block-end: 0.75rem;
    border-block-end: 2px solid currentColor;
    font-family: inherit;
    font-size: 1.1rem;
    font-weight: 800;
    text-align: start;
  }

  body footer {
    margin-block-start: 4rem;
    border-block-start: 1px solid light-dark(#c8c3b8, #393939);
    padding-block-start: 2rem;
    color: light-dark(#57534d, #aaa);
  }

  body footer a {
    color: inherit;
  }
</style>

<Bar
  lang="zh-Hans"
  decoration={frontmatter?.decoration}
  mode={{
  hant: frontmatter?.hant,
  vert: frontmatter?.vert,
  theme: frontmatter?.theme as "auto" | boolean | undefined,
}} />
<main class="article-shell" id="main-content">
  <div
    class:list={[
      "article-card",
      ...classes,
      { "no-paper": frontmatter?.paper === false },
    ]}
    transition:name="main"
    transition:animate="initial"
  >
  {
    entry ? (
      <>
        {cover && (
          <figure class="cover">
            <PhotoImage image={cover} id="cover" />
            {cats[0] && (
              <a
                class="cover-cat"
                href={`/categories/${getCatSlug(cats[0])}/`}
                aria-label={`查看分类：${cats[0]}`}
                lang={mncFallback}
              >
                {cats[0]}
              </a>
            )}
            {cover.caption && <figcaption set:html={cover.caption} />}
          </figure>
        )}
        <header class="article-head">
          <div class="head-kicker" lang={mncFallback}>
            {cats[0] ? (
              <a class="kicker-cat" href={`/categories/${getCatSlug(cats[0])}/`}>
                {cats[0]}
              </a>
            ) : (
              <span class="kicker-cat">文章</span>
            )}
            <time datetime={entry.date as unknown as string}>{dateLabel}</time>
          </div>
          {!entry.hide_title && (
            <h1
              lang={entry.lang}
              transition:name={id}
              transition:animate="initial"
              set:text={entry.title}
              style={`view-transition-name: ${id}`}
            />
          )}
          {entry.desc && <p class="standfirst" lang={mncFallback}>{entry.desc}</p>}
          <aside class="head-meta" lang={mncFallback}>
            {!!cats.length && (
              <div class="meta-row">
                <span class="meta-label">分类</span>
                <span class="meta-values">
                  {cats.map((cat) => (
                    <a href={`/categories/${getCatSlug(cat)}/`}>
                      {cat} <sup>{getCatsInfo().get(cat)}</sup>
                    </a>
                  ))}
                </span>
              </div>
            )}
            {!!tags.length && (
              <div class="meta-row">
                <span class="meta-label">标签</span>
                <span class="meta-values">
                  {tags.map((tag) => (
                    <a href={`/tags/${tag}/`}>
                      {tag} <sup>{getTagsInfo().get(tag)}</sup>
                    </a>
                  ))}
                </span>
              </div>
            )}
          </aside>
        </header>
        <article id="post">
          <slot />
          <LicenceBox parts={licence} />
        </article>
      </>
    ) : (
      <slot />
    )
  }
  </div>

  <section id="comments">
    <div class:list={["article-card", "comments-card", ...classes]}>
      <Comments lang={frontmatter.lang} />
    </div>
  </section>
</main>
}
