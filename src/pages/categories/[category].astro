---
import { getCatSlug, getCatsInfo } from "@/scripts/tags";
import EditorialArticleList from "@/components/listing/EditorialArticleList.astro";
import { _t } from "@/scripts/i18n";

export async function getStaticPaths() {
    const categories = Array.from(getCatsInfo()).map(
        ([category, _count]) => category
    )
    const res = categories.map((category) => ({
        params: { category: getCatSlug(category) },
        props: { category },
    }));
    return res;
}

const { category } = Astro.params;
const { category: catName } = Astro.props;
const t = _t("cmn");
---

<EditorialArticleList
    type="category"
    name={catName}
    title={`${t("common.category")}：${catName}`}
    lang="cmn"
/>
