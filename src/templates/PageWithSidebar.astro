---
import Page from "@templates/zh/Page.astro";
import Sidebar from "@/components/sidebar/Index.astro";
import Paper from "@/components/Paper.astro";
import type { OpenGraphData } from "@/scripts/open-graph";
import Bar from "./Bar.astro";
import Han from "@/components/Mode.astro";

export interface Props {
  title: string;
  bar?: {
    index?: number;
    transparent?: boolean;
  };
  og?: OpenGraphData;
}

const { title, bar, og } = Astro.props;
Astro.locals.noscript = true;
---

<Page title={title} og={og} lang="zh-Hans">
  <Bar {...bar} lang="zh-Hans" />
  <Han hant={false} />
  <main>
    <Sidebar><slot name="comments" slot="comments" /></Sidebar>
    <Paper id="page-main" transitionName="main">
      <section class="inhalt">
        <slot />
      </section>
    </Paper>
  </main>
</Page>

<style>
  main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    inline-size: 100%;
  }
  .inhalt {
    max-inline-size: 750px;
    inline-size: 100dvi;
    padding: 0;
    padding-inline: 0.75rem;
  }
  #main-page {
    flex: 1;
  }
</style>

<style is:global>
  @container html (max-inline-size: 1000px) {
    aside#sidebar {
      order: 2;
    }
    #page-main {
      order: 1;
    }
  }

  @container html (min-inline-size: 1000px) {
    .inhalt {
    }
    main {
    }
    aside#sidebar {
      align-self: start;
    }
  }
</style>
