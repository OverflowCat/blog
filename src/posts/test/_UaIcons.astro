---
import Icon from "@/components/Icon.astro";
import { BROWSER_ICONS_MAP } from "@/scripts/ua-icons";
---

<ul class="ua-icons">
  {
    Object.entries(BROWSER_ICONS_MAP).map(([name, browser]) => (
      <li>
        <span>{name}</span>:
        {browser &&
          (browser?.startsWith("http") ? (
            <img src={browser} alt={browser} width={14} height={14} />
          ) : (
            <Icon name={browser} size={14} />
          ))}
      </li>
    ))
  }
</ul>
