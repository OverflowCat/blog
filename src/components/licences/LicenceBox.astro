---
export interface Props {
  name: "Minzoku" | "PDKR" | "PD" | string | false | undefined | null;
}

import CreativeCommons from "./CreativeCommons.astro";
import PublicDomain from "./PublicDomain.astro";
import Minzoku from "./Minzoku.astro";
const { name } = Astro.props;
---

{
  name ?
    (<div class="licence">
  {
    !!name &&
      (name.startsWith("Cc") ? (
        <CreativeCommons
          sa={name.includes("Sa")}
          nc={name.includes("Nc")}
          nd={name.includes("Nd")}
        >
          <slot />
        </CreativeCommons>
      ) : name === "Minzoku" ? (
        <Minzoku />
      ) : (name === "PD" || name === "PDKR") ? (
        <PublicDomain kind={name}>
          <slot />
        </PublicDomain>
      ) : (
        <slot />
      ))
  }
</div>)
:(<></>)
}

<style lang="less" is:global>
  .licence {
    // border: 2px solid #a7a7a7;
    // background-color: #f9f9f9;
    padding: 6px 18px;
    opacity: 0.75;
    // line-height: 150%;
    a {
      color: inherit;
    }
  }
</style>
