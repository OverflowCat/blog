---
import Page from "@templates/zh/Page.astro";
import Sidebar from "@/components/sidebar/Index.astro";
import type { OpenGraphData } from "@/scripts/open-graph";
import Bar from "./Bar.astro";

export interface Props {
	title: string;
	bar?: {
		index?: number;
		transparent?: boolean;
	};
	og?: OpenGraphData;
}

const { title, bar, og } = Astro.props;
Astro.locals.noscript = true;
---

<Page title={title} og={og} lang="zh-Hans">
  <Bar
    {...bar}
    lang="zh-Hans"
    mode={{ theme: true, hant: false, vert: true }}
  />
  <main class="page-shell-footbar">
    <section class="page-main-top" transition:animate="initial" transition:name="main">
      <section id="page-main-footbar" class="inhalt page-content-footbar">
        <slot />
      </section>
    </section>
    <!-- <section class="page-footbar-bottom">
      <Sidebar><slot name="footbar" slot="comments" /></Sidebar>
    </section> -->
  </main>
</Page>

<style is:global>
  .page-shell-footbar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    inline-size: min(1280px, calc(100% - 1.25rem));
    margin-inline: auto;
    align-items: stretch;
  }

  .page-main-top,
  .page-footbar-bottom {
    display: block;
  }

  .page-content-footbar {
    padding: 0;
  }

  .page-footbar-bottom aside#sidebar {
    inline-size: 100%;
    max-inline-size: none;
  }

  .page-footbar-bottom aside#sidebar > .paper {
    inline-size: 100%;
  }

  @container html (max-inline-size: 640px) {
    .page-shell-footbar {
      inline-size: min(100%, calc(100% - 0.5rem));
      gap: 0.75rem;
    }

    .page-content-footbar {
      padding: 0.75rem;
    }
  }

  @container html (min-inline-size: 640px) {
    #page-main-footbar {
      padding-inline: 2rem;
    }
  }

  @container html (min-inline-size: 800px) {
    #page-main-footbar {
      padding-inline: 3rem;
    }
  }

  @container html (min-inline-size: 960px) {
    #page-main-footbar {
      padding-inline: 3rem;
    }
  }
</style>