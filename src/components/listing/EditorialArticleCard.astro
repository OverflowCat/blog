---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { getCatSlug } from "@/scripts/tags";
import "@/styles/manchu.less";
import "@fontsource/noto-sans-mongolian";

export interface Props {
  post: CollectionEntry<"blog">;
  index: number;
}

const { post, index } = Astro.props;
const { data } = post;
const photo = data.photo;
const icon = data.icon;
const hasPhoto = Boolean(
  photo &&
    photo.hide !== true &&
    photo.hide !== "list" &&
    photo.list !== false &&
    (photo.src || photo.img),
);

const declared = data.card;
let variant = declared === "landscape" ? "wide" : declared;
if (hasPhoto) {
  if (variant === "wide" || variant === "tall") {
    // keep declared
  } else if (index % 9 === 0) variant = "wide";
  else if (index % 7 === 0) variant = "tall";
  else variant = "standard";
} else {
  if (!variant || !["mini", "text"].includes(variant)) variant = "text";
}

const tone =
  Array.from(post.id).reduce((sum, char) => sum + char.charCodeAt(0), 0) % 4;
const categories = data.categories ?? [];
const dateLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(data.date);
const isDaily = post.id.startsWith("daily/");
const dailySeparator = isDaily ? data.title.indexOf(" / ") : -1;
const dailyDate =
  dailySeparator >= 0 ? data.title.slice(0, dailySeparator) : undefined;
const displayTitle =
  dailySeparator >= 0 ? data.title.slice(dailySeparator + 3) : data.title;
const isOverlayCard = hasPhoto && (variant === "wide" || variant === "standard");
---

<article
  class:list={[
    "editorial-card",
    `variant-${variant}`,
    `tone-${tone}`,
    { "has-intro": index < 12 },
    { "lang-mnc": data.lang === "mnc" },
    { "has-photo": hasPhoto },
  ]}
  lang={data.lang === "mnc" ? undefined : data.lang}
  style={`--card-order: ${Math.min(index, 10)}; grid-column: span ${variant === "wide" || variant === "standard" ? 2 : 1}; grid-row: span ${variant === "tall" ? 2 : 1};`}
>
  <a href={`/${post.id}/`} transition:name={post.id} transition:animate="initial">
    {
      hasPhoto && photo && (
        <div class="card-image">
          {photo.img ? (
            <Picture
              src={photo.img}
              alt={photo.alt ?? data.title}
              widths={[480, 800, 1200]}
              sizes={
                variant === "wide"
                  ? "(max-width: 580px) 100vw, 50vw"
                  : "(max-width: 580px) 100vw, 25vw"
              }
              formats={["avif", "webp", "jpg"]}
              loading={index < 6 ? "eager" : "lazy"}
            />
          ) : (
            <img
              src={photo.src}
              alt={photo.alt ?? data.title}
              loading={index < 6 ? "eager" : "lazy"}
              fetchpriority={index < 3 ? "high" : "auto"}
            />
          )}
          {isOverlayCard && (
            <div class="image-meta" lang={data.lang === "mnc" ? "zh" : undefined}>
              <time datetime={dailyDate ?? data.date.toISOString()}>
                {dailyDate ?? dateLabel}
              </time>
              {icon && (
                <span class="image-icon" aria-hidden="true">
                  <Icon name={icon} />
                </span>
              )}
            </div>
          )}
          {
            icon && variant !== "mini" && !isOverlayCard && (
              <span class="image-icon" aria-hidden="true">
                <Icon name={icon} />
              </span>
            )
          }
        </div>
      )
    }
    <div class="card-copy">
      {!isOverlayCard && (
        <div class="card-kicker" lang={data.lang === "mnc" ? "zh" : undefined}>
          {
            (!hasPhoto || variant === "mini") && (
              <span>{categories.length > 0 ? categories[0] : "文章"}</span>
            )
          }
          <time datetime={dailyDate ?? data.date.toISOString()}>
            {dailyDate ?? dateLabel}
          </time>
        </div>
      )}
      {
        icon && (!hasPhoto || variant === "mini") && (
          <span class="card-icon" aria-hidden="true">
            <Icon name={icon} />
          </span>
        )
      }
      <h2 lang={data.lang}>{displayTitle}</h2>
      {
        data.desc && (
          <p lang={data.lang === "mnc" ? "zh" : undefined}>{data.desc}</p>
        )
      }
    </div>
  </a>
  {
    categories[0] && (
      <a
        class="category-link"
        href={`/categories/${getCatSlug(categories[0])}/`}
        aria-label={`查看分类：${categories[0]}`}
        lang={data.lang === "mnc" ? "zh" : undefined}
      >
        {categories[0]}
      </a>
    )
  }
</article>

<style>
  .editorial-card {
    --card-border: light-dark(#171717, #55524d);
    --card-accent: light-dark(#c92b38, #ef5360);

    position: relative;
    block-size: 100%;
    min-block-size: 0;
    min-inline-size: 0;
    border: 1px solid var(--card-border);
    border-radius: 0;
    background: light-dark(#f7f6f2, #202020);
    color: light-dark(#111, #f4f1eb);
    overflow: hidden;
    content-visibility: auto;
    contain-intrinsic-size: auto 360px;
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }

  .editorial-card::after {
    content: "";
    position: absolute;
    z-index: 3;
    inset: 0;
    border: 3px solid var(--card-accent);
    opacity: 0;
    pointer-events: none;
    transform: scale(0.985);
    transition:
      opacity 180ms ease,
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .editorial-card:hover,
  .editorial-card:focus-within {
    background: light-dark(#fff, #272727);
    border-color: var(--card-accent);
  }

  .editorial-card:hover::after,
  .editorial-card:focus-within::after {
    opacity: 1;
    transform: scale(1);
  }

  .lang-mnc .card-copy {
    flex: 1;
    min-height: 0;
  }

  .lang-mnc h2 {
    flex: 1;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
    writing-mode: vertical-lr;
    font-feature-settings: "kern" 1, "liga" 1, "calt" 1, "vert" 1;
    text-orientation: sideways;
  }

  .lang-mnc .card-kicker {
    writing-mode: horizontal-tb;
  }

  .editorial-card > a:first-child {
    block-size: 100%;
    display: grid;
    grid-template-rows: 42% 1fr;
    color: inherit;
    text-decoration: none;
  }

  .variant-tall > a:first-child {
    grid-template-rows: 50% 1fr;
  }

  .variant-wide > a:first-child,
  .variant-standard > a:first-child {
    position: relative;
    display: block;
    isolation: isolate;
  }

  .variant-wide .card-image,
  .variant-standard .card-image {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .variant-wide .card-image::after,
  .variant-standard .card-image::after {
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.02) 25%,
      rgb(0 0 0 / 0.38) 62%,
      rgb(0 0 0 / 0.72) 100%
    );
    opacity: 1;
  }

  .variant-wide .card-copy,
  .variant-standard .card-copy {
    position: absolute;
    z-index: 2;
    inset-inline: 0;
    inset-block-end: 0;
    min-block-size: 0;
    padding: clamp(0.8rem, 1.2vw, 1.1rem) clamp(1rem, 2vw, 1.5rem);
    justify-content: flex-end;
    gap: 0.35rem;
    background: light-dark(rgb(255 255 255 / 0.7), rgb(33 33 33 / 0.6));
    color: light-dark(#111, #fff);
    backdrop-filter: blur(8px) saturate(0.82);
    -webkit-backdrop-filter: blur(8px) saturate(0.82);
  }

  .variant-mini {
    min-block-size: 10rem;
  }

  .variant-mini .card-image,
  .variant-mini p {
    display: none;
  }

  .variant-mini h2 {
    font-size: 1.35rem;
  }

  .variant-text {
    min-block-size: 13rem;
  }

  .variant-text .card-copy,
  .variant-mini .card-copy {
    flex: 1;
    justify-content: flex-start;
  }

  .tone-0 {
    --card-accent: light-dark(#385f83, #74a4d1);
  }

  .tone-1 {
    --card-accent: light-dark(#a12632, #ef5360);
  }

  .tone-2 {
    --card-accent: light-dark(#08756d, #58c5ba);
  }

  .tone-3 {
    --card-accent: light-dark(#896400, #e3be54);
  }

  .card-image {
    position: relative;
    min-block-size: 0;
    overflow: hidden;
    background: #111;
  }

  .card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 55%, rgb(0 0 0 / 0.32));
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .image-icon {
    position: absolute;
    z-index: 1;
    inset-inline-end: 0.75rem;
    inset-block-end: 0.75rem;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    display: grid;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.8);
    background: rgb(17 17 17 / 0.82);
    color: #fff;
    font-size: 1.35rem;
    backdrop-filter: blur(8px);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-meta {
    position: absolute;
    z-index: 2;
    inset-block-start: 0.65rem;
    inset-inline-end: 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: #fff;
  }

  .image-meta time {
    border: 1px solid rgb(255 255 255 / 0.72);
    padding: 0.35rem 0.5rem;
    background: rgb(17 17 17 / 0.78);
    font-size: 0.68rem;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .image-meta .image-icon {
    position: static;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    font-size: 1rem;
  }

  .card-image :global(picture),
  .card-image :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .card-image :global(img) {
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-card:hover .card-image :global(img) {
    transform: scale(1.055);
  }

  .editorial-card:hover .card-image::after,
  .editorial-card:focus-within .card-image::after {
    opacity: 1;
  }

  .card-copy {
    min-block-size: 0;
    min-inline-size: 0;
    padding: clamp(0.75rem, 1.2vw, 1.15rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.75rem;
    overflow: hidden;
  }

  .card-icon {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    flex: none;
    display: grid;
    place-items: center;
    margin-block-start: 0.25rem;
    border: 1px solid currentColor;
    color: currentColor;
    font-size: 1.45rem;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-card:hover .card-icon,
  .editorial-card:focus-within .card-icon,
  .editorial-card:hover .image-icon,
  .editorial-card:focus-within .image-icon {
    background: light-dark(#111, #f4f1eb);
    color: light-dark(#fff, #171717);
    transform: rotate(-7deg) scale(1.08);
  }

  .card-kicker {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: currentColor;
    opacity: 0.66;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .card-kicker span {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-kicker time {
    flex: none;
    white-space: nowrap;
  }

  h2 {
    flex-shrink: 0;
    margin-block: 0.5rem 0;
    color: inherit;
    font-size: 1.55rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: start;
    overflow-wrap: anywhere;
    transition:
      color 180ms ease,
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .variant-wide h2 {
    font-size: 2.25rem;
  }

  .variant-wide p,
  .variant-standard p {
    margin-block-start: 0.15rem;
    opacity: 0.82;
    -webkit-line-clamp: 2;
  }

  .editorial-card:hover h2,
  .editorial-card:focus-within h2 {
    color: var(--card-accent);
    transform: translateY(-0.12rem);
  }

  .variant-wide:hover h2,
  .variant-wide:focus-within h2,
  .variant-standard:hover h2,
  .variant-standard:focus-within h2 {
    color: light-dark(#111, #fff);
  }

  p {
    flex-shrink: 0;
    margin-block-start: 0.5rem;
    color: currentColor;
    opacity: 0.7;
    font-size: 0.9rem;
    line-height: 1.55;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .category-link {
    position: absolute;
    z-index: 4;
    inset-block-start: 0.65rem;
    inset-inline-start: 0.65rem;
    max-inline-size: calc(100% - 1.3rem);
    border-radius: 0;
    padding: 0.35rem 0.5rem;
    overflow: hidden;
    background: #111d;
    color: #fff;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 750;
    line-height: 1;
  }

  .editorial-card:not(.has-photo) .category-link,
  .variant-mini .category-link {
    display: none;
  }

  @container article-list (inline-size <= 580px) {
    .editorial-card {
      block-size: auto;
      min-block-size: 18rem;
    }

    .variant-mini {
      min-block-size: 12rem;
    }

    .variant-tall {
      min-block-size: 30rem;
    }

    .variant-wide h2 {
      font-size: 1.65rem;
    }

    .variant-wide .card-copy,
    .variant-standard .card-copy {
      padding: 0.8rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-card,
    .editorial-card::after,
    .card-image :global(img),
    .card-image::after,
    .card-icon,
    .image-icon,
    h2 {
      animation: none;
      transition: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .editorial-card.has-intro {
      animation: card-enter 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--card-order) * 38ms);
    }
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(0.85rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
