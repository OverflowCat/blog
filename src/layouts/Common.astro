---
import type { Frontmatter } from "@/types";
import "@/styles/icon.less";
import LicenceBox from "@/components/licences/LicenceBox.astro";
import type { IconName } from "@/scripts/icons";
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
export interface Props {
  layoutProps: {
    url?: string;
    file?: string;
    frontmatter?: Frontmatter;
  };
  icons?: {
    calendar: IconName;
    category: IconName;
    tag: IconName;
  };
}
function arrify<T>(x: T | T[]): T[] {
  return Array.isArray(x) ? x : [x];
}

let { icons, layoutProps } = Astro.props;
if (String(layoutProps.frontmatter?.categories).includes("惊鸿一瞥")) {
  icons = {
    calendar: "harmony-calendar-badge-clock",
    category: "harmony-folder-badge-plus",
    tag: "harmony-label",
  };
} else if (!icons) {
  icons = {
    calendar: "mdi:date-range",
    category: "pixelarticons:folder-plus",
    tag: "pixelarticons:label",
  };
}
const { url, file } = layoutProps;
import { resolvePostId } from "@/scripts/post";
const id = resolvePostId(url ?? file ?? Astro.url.pathname);

const frontmatter = (await getEntry("blog", id))?.data;
if (!frontmatter) {
  throw new Error(`Post ${id} not found.`);
}
const { date } = frontmatter;
const cats = arrify(frontmatter.categories);
const tags = arrify(frontmatter.tags);
const cover = frontmatter.photo?.hide ? undefined : frontmatter.photo;
const licence = frontmatter.licence ?? "CcByNc";

import "@/styles/article.less";
import { Picture } from "astro:assets";
import { getCatSlug } from "@/scripts/tags";
---

{
  cover && (
    <figure class="cover">
      {cover.img !== undefined ? (
        <Picture
          id="cover"
          src={cover.img}
          alt={cover.alt ?? ""}
          formats={["avif", "webp", "jpg"]}
        />
      ) : (
        <img id="cover" src={cover.src} alt={cover.alt} />
      )}
      {cover.caption && <figcaption set:html={cover.caption} />}
    </figure>
  )
}
{
  !frontmatter.hide_title && (
    <h1
      transition:name={id}
      set:text={frontmatter.title}
      style={`view-transition-name: ${id}`}
    />
  )
}
<div class="info">
  <div>
    <!-- <div class:list={[icons.calendar ?? 'i-mdi:date-range', 'icon']}></div> -->
    <Icon name={icons.calendar} class="icon" />
    日期：
    <time
      datetime={date as unknown as string}
      set:text={new Date(frontmatter.date).toLocaleDateString("zh")}
    />
  </div>
  {
    !!cats.length && (
      <div>
        {/* <div class:list={[icons.category ?? 'i-pixelarticons:folder-plus', 'icon']}></div> */}
        <Icon name={icons.category} class="icon" />
        分类：
        {cats.map((cat) => (
          <a class="cat" href={`/categories/${getCatSlug(cat)}/`}>
            {cat}
          </a>
        ))}
      </div>
    )
  }
  {
    !!tags.length && (
      <div>
        {/* <div class:list={[icons.tag ?? 'i-pixelarticons:label', 'icon']}></div> */}
        <Icon name={icons.tag} class="icon" />
        标签：
        {tags.map((tag) => (
          <a class="tag" href={`/tags/${tag}/`}>
            {tag}
          </a>
        ))}
      </div>
    )
  }
</div>
<article id="post">
  <slot />
</article>
<LicenceBox name={licence} />

<style is:global lang="less">
  .icon {
    @apply inline-block;
    vertical-align: sub;
    width: 1.2em;
    height: 1.2em;
  }
  .cover {
    margin: 0;
    height: auto;
    #cover {
      object-fit: contain;
      inline-size: 100%;
      block-size: auto;
      border-radius: 4px;
      :not(#vert:target) & {
        animation-timeline: --page-timeline;
        animation-name: cover-fade-and-zoom;
        animation-duration: 1s;
        transform-origin: center 90%;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      @keyframes cover-fade-and-zoom {
        0%,
        1% {
          opacity: 1;
          transform: scale(1);
        }
        100% {
          opacity: 0;
          transform: scale(3);
        }
      }
    }

    figcaption {
      margin-inline: 2rem;
      text-align: center;
      font-size: 0.9rem;
      color: #555; // TODO: use theme color
    }
  }
  .info {
    margin-block: 1rem;
    color: var(--text-secondary, #2e2e2e);
    font-size: 0.9rem;
    text-align: center;
    a.tag,
    a.cat {
      @apply no-underline border-none p-1 font-600;
      color: var(--text-tag) !important;
      margin-block: 3px;
      margin-inline: 3px;
      margin-inline: 2px;
      transition:
        background-color 0.1s,
        border 0.1s,
        color 0.1s;
      // border-radius: 0.5rem;
      border: 2px solid transparent;
      background-color: var(--bg-tag);
      color: var(--text-secondary);
      &:hover {
        background-color: var(--bg-tag-hover);
        border: 2px solid var(--bg-secondary);
      }
      &:active {
        background-color: var(--bg-tag-active);
      }
    }
    & > div {
      margin: 0.8rem 0;
    }
  }
</style>
