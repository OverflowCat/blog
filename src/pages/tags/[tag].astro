---
import { getTagsInfo } from "@/scripts/tags";
import EditorialArticleList from "@/components/listing/EditorialArticleList.astro";
import { _t } from "@/scripts/i18n";

export async function getStaticPaths() {
    const tags = Array.from(await getTagsInfo()).map(([tag, _count]) => tag);
    const res = tags.map((tag) => ({ params: { tag } }));
    return res;
    // [
    // { params: { /* required */ }, props: { /* optional */ } },
    // { params: { ... } },
    // { params: { ... } },
    // ...
    // ];
}

const { tag } = Astro.params;
const t = _t("cmn");
---

<EditorialArticleList
    type="tag"
    name={tag}
    title={`${t("common.tag")}：${tag}`}
    lang="cmn"
/>
