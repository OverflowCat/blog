---
import { getTagLabel, getTagSlug, getTagsInfo } from "@/scripts/tags";
import EditorialArticleList from "@/components/listing/EditorialArticleList.astro";
import { _t } from "@/scripts/i18n";

export async function getStaticPaths() {
	const tags = Array.from(await getTagsInfo()).map(([tag, _count]) => tag);
	const res = tags.map((tag) => ({
		params: { tag: getTagSlug(tag) },
		props: { tag },
	}));
	return res;
	// [
	// { params: { /* required */ }, props: { /* optional */ } },
	// { params: { ... } },
	// { params: { ... } },
	// ...
	// ];
}

const { tag: tagName } = Astro.props;
const t = _t("cmn");
---

<EditorialArticleList
    type="tag"
    name={tagName}
    title={`${t("common.tag")}：${getTagLabel(tagName, "cmn")}`}
    lang="cmn"
/>
