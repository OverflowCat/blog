---
import type { Decoration } from "@/scripts/decoration";
import Harmony from "./Harmony.astro";

export interface Props {
	theme?: "transparent" | "auto";
	decoration?: Decoration;
}

let src = "/new-logo.svg"; // "https://remnote-user-data.s3.amazonaws.com/f8gKx0Gme6bMH6i0C1u9WMvu0a_FrROFO69-uwow3_q5XAMN7sy-G77NUEkAk1Z3SkWyXijliwe9rWifldNdycmhnM8y2fvxH6t6InSoPCDDklhW0aiDFLfMq3O1JRd4.svg"
const { decoration } = Astro.props;
let inlineSize = "";

if (decoration === "isekai") {
  src = "/isekai-damen.svg";
}

if (decoration === "langs") {
	src = "https://tong.xinshijiededa.men/logo-yellow.svg";
	inlineSize = "inline-full overflow-x-clip";
}

if (decoration === "harmony") {
	inlineSize = "inline-full";
}
---

<div class={`logowrapper relative ${inlineSize} select-none`}>
  <img class="logo block vert-hide" src={src} alt="新世界的大門" id="logo" />
  <img class="logo vert-block max-inline-72" src="/logo-vert.svg"  alt="新世界的大門" />
  {decoration === "langs" ? (
    <div class="vert-hide absolute inset-is-0 mbs--24 opacity-30 inline-100vi"> 
        <img src="https://tong.xinshijiededa.men/langs.svg" height="22" alt="typography" id="typography"/>
        <img class="mis" src="https://tong.xinshijiededa.men/langs2.svg" height="22" alt="typography" id="typography"/>
        <img class="mis--120" src="https://tong.xinshijiededa.men/langs2.svg" height="22" alt="typography" id="typography"/>
        <img class="mis--50" src="https://tong.xinshijiededa.men/langs.svg" height="22" alt="typography" id="typography"/>
    </div>
  ) : decoration === "harmony" ? (
    <Harmony />
  ) : decoration === null ? (
    <></>
  ) : (
    <div class="vert-hide absolute floating opacity-40" style="inset-block-start: -300px; inset-inline-start: -220px;"> 
      <img src="/decorations/planet.svg" class="rotating" width="450" height="450" alt="planet" id="planet"/>
    </div>
    <i class="roloc i-mingcute:christmas-hat-fill x-i-mdi:satellite-variant absolute inset-bs-0 inset-is-50 w-12! h-12! text-lg opacity-40 hover:opacity-100"></i>
    <i class="roloc i-mdi:christmas-star x-i-mdi:satellite-variant absolute inset-bs-20 inset-is-65 w-10! h-10! rotate-90 text-lg opacity-40 hover:opacity-100"></i>
    <i class="roloc floating i-icon-park-solid:christmas-tree x-i-mdi:rocket hover:x-i-mdi:rocket-launch absolute inset-bs-12 inset-is-25 w-10! h-10! rotate-50 text-lg opacity-40 hover:opacity-100"></i>
  )}
</div>

<style lang="less">
  @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {
    .logowrapper div, .logowrapper .vert-block {
      display: none;
    }
  }
  @keyframes rotating {
    0% {
      rotate: 0deg;
    }
    100% {
      rotate: 360deg;
    }
  }
  @keyframes floating {
    0% {
      translate: 0 0;
    }
    50% {
      translate: 0 9px;
    }
    100% {
      translate: 0 0;
    }
  }
  .rotating {
    animation: rotating 100s ease-in-out infinite;
  }
  .floating {
    animation: floating 8s ease-in-out infinite;
  }
  .logo {
    @apply relative z-100 m-auto;
    block-size: 72px;
  }
  .logowrapper {
    * {
      transition: opacity 0.2s ease;
    }
  }
</style>
