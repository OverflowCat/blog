---
import Page from "@templates/zh/Page.astro";
import Sidebar from "@/components/sidebar/Index.astro";
import Paper from "@/components/Paper.astro";
import type { OpenGraphData } from "@/scripts/open-graph";
import Bar from "./Bar.astro";

export interface Props {
  title: string;
  bar?: {
    index?: number;
    transparent?: boolean;
  };
  og?: OpenGraphData;
}

const { title, bar, og } = Astro.props;
Astro.locals.noscript = true;
---

<Page title={title} og={og} lang="zh-Hans">
  <Bar
    {...bar}
    lang="zh-Hans"
    mode={{ theme: true, hant: false, vert: true }}
  />
  <main class="flex flex-wrap inline-full gap-4 justify-center items-center">
    <Sidebar><slot name="sidebar" slot="comments" /></Sidebar>
    <Paper id="page-main" transitionName="main">
      <section class="inhalt p-0 p-inline-3">
        <slot />
      </section>
    </Paper>
  </main>
</Page>

<style is:global>
  @container html (max-inline-size: 1000px) {
    aside#sidebar {
      order: 2;
    }
    #page-main {
      order: 1;
    }
  }

  @container html (min-inline-size: 1000px) {
    .inhalt {
      inline-size: 100%;
      max-inline-size: 800px;
    }
    aside#sidebar {
      align-self: start;
      flex-basis: 0;
    }
  }
</style>
