---
import type { Decoration } from "@/scripts/decoration";

export interface Props {
  index?: number;
  theme?: "transparent" | "auto";
  lang: "zh-Hans" | "zh-Hant" | "en";
  decoration?: Decoration;
  mode: {
    theme?: boolean | "auto";
    hant?: boolean;
    vert?: boolean;
  };
}

import Logo from "@components/Logo.astro";
import slogans from "@scripts/slogans";
import { pick } from "@/scripts/serendipity";
import assert from "node:assert";

import Mode from "@/components/Mode.astro";

console.log(Astro.url.toString(), Astro.locals);

const items = [
  ["文章", "Home", "/"],
  ["归档", "Archives", "/archives"],
  ["友链", "Friends", "/friends"],
  ["订阅", "RSS", "/atom.xml"],
  ["关于", "About", "/about"],
];
let { index, theme, lang, mode, decoration } = Astro.props;
if (!lang) lang = "zh-Hans";
const slogan = pick(slogans.filter((s) => s[lang]))[lang];
assert(slogan, "slogan is undefined");
---

<nav>
  <div id="logo">
    <Logo theme={theme} decoration={decoration} />
  </div>
  <div id="slogan" set:text={typeof slogan === "string" ? slogan : slogan[0]} />
</nav>
<nav id="sticky">
  <div class="backdrop">
    <div class="logowrapper edge min-inline-20 vert-hide">
      <img class="logo" src="/new-logo.svg" alt="logo" />
    </div>
    <ul class="block">
      {
        items.map((item, i) => (
          <li transition:name={`navbar-${i}`} id={`nav-${i}`}>
            <a
              href={item[2]}
              data-replace={index === i ? "本页" : item[0]}
              class={index === i ? "current" : ""}
            >
              <span>{item[0]}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="edge min-inline-20 text-end">
      {
        (
          <Mode
            float={false}
            vert={mode?.vert}
            hant={mode?.hant}
            theme={mode?.theme}
          />
        )
      }
    </div>
  </div>
</nav>
<style is:global lang="less">
  nav#sticky {
    z-index: 1000;
    // width: fit-content;
    @apply m-auto mbs--1 mbe-2 sticky min-block-10 pbe-2 inline-full inset-bs-0 inset-is-0;
    align-items: space-between;
    .logo {
      @apply h-8 m-1;
      animation-timeline: --page-timeline;
      animation-name: navlogo;
      animation-range: 0px 120px;
    }
  }
  @keyframes navblur {
    0% {
      backdrop-filter: blur(0px);
    }
    3% {
      backdrop-filter: blur(0px);
    }
    10% {
      backdrop-filter: blur(12px);
    }
    100% {
      backdrop-filter: blur(15px);
    }
  }
  @keyframes navlogo {
    0% {
      opacity: 0;
    }
    80% {
      opacity: 0;
    }
    97% {
      opacity: 0.6;
    }
    100% {
      opacity: 0.6;
    }
  }
  .backdrop {
    @apply flex absolute justify-center items-start inline-full;
    pointer-events: none;
    * {
      pointer-events: all;
    }
    z-index: 0;
    inset: 0;
    /* Extend backdrop surface to the bottom */
    --extended-by: 250px;
    inset-block-end: calc(-1 * var(--extended-by));
    /* Mask out the part falling outside the nav */
    --cutoff: calc(100% - var(--extended-by));
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0,
      black var(--cutoff),
      transparent var(--cutoff)
    );
    #vert:target & {
      -webkit-mask-image: linear-gradient(
        to left,
        black 0,
        black var(--cutoff),
        transparent var(--cutoff)
      );
    }

    animation-name: navblur;
    animation-timeline: --page-timeline;
    animation-range: 123px 155px;
    animation-fill-mode: both;
  }
</style>
<style lang="less">
  :root {
    --indicator-size: 0.15em;
  }
  * {
    user-select: none;
  }
  #slogan {
    @apply m-block-2 m-inline-0 relative z-100;
    color: var(--hint-color, #3c3c3c);
  }
  #logo,
  #slogan,
  ul {
    text-align: center;
    place-items: center center;
  }
  #logo {
    @apply pbs-4 pbe-1 p-inline-.5 m-block-0 m-inline-auto;
  }
  ul {
    @apply flex justify-center text-4.5 gap-0 p-0;
    margin-block-start: var(--indicator-size);
    margin-block-end: var(--indicator-size);
  }
  li {
    @apply inline-block text-center;
    font-weight: 700;
  }
  a {
    line-height: 200%;
    @apply inline-block decoration-none;
    outline: none;
    padding-inline-start: 0.7em;
    padding-inline-end: 0.7em;
    color: var(--hint-color, #434343);
    transition: background-color 0.3s ease;
    border-block-end: 2px solid transparent; /* indicator-20250221 */
    &:hover,
    &:focus-visible {
      background-color: var(--bg-dim);
    }
  }

  /*
  li:has(a:is(:hover, :focus-visible)),
  ul:not(:has(a:is(:hover, :focus-visible))) a.current {
    anchor-name: --indicator;
  }
  ul::before {
    content: "";
    position: absolute;
    block-size: var(--indicator-size);
    background-color: var(--logo-color);
    transition: all 0.3s ease;
    inset-block-start: anchor(--indicator end);
    inset-inline-start: anchor(--indicator start);
    block-size: anchor(--indicator);
    inline-size: anchor-size(--indicator);
  }
 */
  .edge {
    display: none;
  }
  nav#sticky {
    backdrop-filter: blur(15px); // fallback for browsers not supporting scroll-timeline
  }
  @supports (scroll-timeline-name: --page-timeline) and (container-type: inline-size) {
    .edge {
      display: unset;
    }
    nav#sticky {
      backdrop-filter: none; // overrides the fallback
    }
    .backdrop {
      @apply justify-between;
    }
  }
  @container html (max-inline-size: 768px) {
    .separator {
      display: none;
    }
    .edge {
      @apply min-inline-0;
    }
  }
  @container html (max-inline-size: 520px) {
    .edge:first-child, #nav-1 {
      // hide when screen is too narrow
      display: none;
    }
    a {
      padding-inline-start: 0.5em;
      padding-inline-end: 0.5em;
    }
  }
</style>
