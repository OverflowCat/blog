---
export interface Props {
  /** 是否允许商业使用 */
  nc?: boolean;
  /** 是否需要以相同方式共享 */
  sa?: boolean;
  /** 是否允许演绎 */
  nd?: boolean;
}
import { Icon } from "astro-icon/components";
import "@/styles/icon.less";
const { nc, sa, nd } = Astro.props;
if (sa && nd) {
  throw new Error(
    "不允许同时使用相同方式共享和禁止演绎。禁止演绎的作品一定以相同方式共享。"
  );
}
const licence = `BY${nc ? "-NC" : ""}${nd ? "-ND" : ""}${sa ? "-SA" : ""}`;
---

<p>
  <span class="icon">
    <Icon name="ri:creative-commons-fill" />
  </span>
  <span class="icon">
    <Icon name="ri:creative-commons-by-fill" />
  </span>
  {
    nc && (
      <span class="icon">
        <Icon name="ri:creative-commons-nc-fill" />
      </span>
    )
  }
  {
    nd && (
      <span class="icon">
        <Icon name="ri:creative-commons-nd-fill" />
      </span>
    )
  }
  本作品采用
  <b
    >知识共享 署名{
      nc && "—非商业性使用"
    }{
      nd && "—禁止演绎"
    }{
      sa && "—相同方式共享"
    } 4.0 国际许可协议</b
  >（<a
    href={"https://creativecommons.org/licenses/" + licence.toLowerCase() + "/4.0/legalcode"}
    target="_blank">CC {licence} 4.0 International</a
  >）许可。阁下可自由地<b>共享</b>（复制、发行）{
    !nd && (<>和<b>演绎</b>（修改、转换或二次创作）</>)
  }本作品，唯须遵守许可协议条款。
</p>
