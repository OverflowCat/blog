---
import Paper from "@/components/Paper.astro";
import "@/styles/icon.less";
import Common from "./Common.astro";
import Comments from "@/components/comments/Comments.astro";
import "@shikijs/twoslash/style-rich.css";
const { frontmatter } = Astro.props;
import Bar from "@/templates/Bar.astro";
import "@/styles/form.less";
import "@/styles/handdrawn.less";
import type { Frontmatter } from "@/types";
const classes = frontmatter?.resizable !== false ? ["resizable"] : [];
export type Props = {
	frontmatter?: Frontmatter;
	content?: Frontmatter;
	file: string;
	url: string;
};
---

{Astro.locals.renderer === 'rss' ?
  <Common layoutProps={Astro.props}></Common>
  <slot />
:
<style is:global is:inline>
  :root {
    color-scheme: light;
  }
  .paper {
    margin: auto;
    inline-size: 1024px;
    max-inline-size: calc(100dvi - 2em);
    min-inline-size: 320px;
  }

  @container html (max-inline-size: 560px) {
    .resizable {
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 100%;
    }
  }

  section#comments {
    margin-block: 1em;
  }
</style>
<Bar
  lang="zh-Hans" 
  decoration={null}
  icons={true}
  logo={false}
  mode={{
  hant: false,
  vert: false,
  theme: false,
}} />

<Paper
  transitionName="main"
  padding={true}
  paper={false}
  classes={classes}
>
{
  frontmatter ?
  <Common layoutProps={Astro.props}>
    <slot />
  </Common> : <slot />
}
</Paper>

<section id="comments">
  <Paper padding={true} paper={true} classes={classes}>
    <Comments />
  </Paper>
</section>

<style lang="less" is:global>
  article#post {
    @apply relative overflow-none!;
 }
  h2, h3 {
    @apply sticky! inset-bs-0 red;
  }
</style>
