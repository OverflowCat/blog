---
import Icon from "@/components/Icon.astro";
import DailyCalendar from "@/components/listing/DailyCalendar.astro";
import AuthorInfo from "@/components/sidebar/AuthorInfo.astro";
import Search from "@/components/sidebar/Search.astro";
import SidebarHeading from "@/components/sidebar/SidebarHeading.astro";
import { getCatsInfo, getCatSlug, getTagsInfo } from "@/scripts/tags";
import { _t } from "@/scripts/i18n";

export interface Props {
  lang?: string;
}

const { lang = "cmn" } = Astro.props;

const categories = Array.from(getCatsInfo())
  .sort((a, b) => b[1] - a[1]);
const tags = Array.from(getTagsInfo())
  .sort((a, b) => b[1] - a[1]);
const socialLinks = [
  { href: "https://github.com/OverflowCat", icon: "ri:github-fill", label: "GitHub" },
  { href: "https://t.me/OverflowCat", icon: "mdi:telegram", label: "Telegram" },
  { href: "mailto:overflowcat+blog@gmail.com", icon: "mdi:email", label: "邮件" },
  { href: "/atom.xml", icon: "mdi:rss", label: "RSS" },
];
const t = _t(lang);
---

<aside class="editorial-sidebar" aria-label="站点信息与内容导航">
  <section class="profile" aria-labelledby="sidebar-author-title">
    <AuthorInfo />
    <nav class="social-links" aria-label="其他平台">
      {
        socialLinks.map(({ href, icon, label }) => (
          <a href={href} aria-label={label} title={label}>
            <Icon name={icon} />
          </a>
        ))
      }
    </nav>
  </section>

  <section class="sidebar-section sidebar-search" aria-labelledby="sidebar-search-title">
    <Search />
    <DailyCalendar />
  </section>

  <section class="sidebar-section" aria-labelledby="sidebar-categories-title">
    <SidebarHeading
      id="sidebar-categories-title"
      text={t("common.category")}
    />
    <ul class="category-list">
      {
        categories.map(([category, count]) => (
          <li>
            <a href={`/categories/${getCatSlug(category)}/`}>
              <span>{category}</span>
              <small>{count}</small>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sidebar-section" aria-labelledby="sidebar-tags-title">
    <SidebarHeading id="sidebar-tags-title" text={t("common.tag")} />
    <div class="tag-list">
      {
        tags.map(([tag, count]) => (
          <a href={`/tags/${tag}/`}>
            {tag}<small>{count}</small>
          </a>
        ))
      }
    </div>
  </section>

</aside>

<style>
  .editorial-sidebar {
    min-inline-size: 0;
    padding: clamp(1rem, 2vw, 2rem);
    border-inline-end: 1px solid light-dark(#c8c3b8, #393939);
    font-size: 1.125rem;
  }

  .profile {
    padding-block-end: 1.5rem;
  }

  .profile :global(.site-author) {
    margin-block-start: 0;
    padding-inline-start: 0;
  }

  .profile :global(.site-description) {
    color: currentColor;
    font-size: 1.05rem;
    writing-mode: vertical-lr;
  }

  .profile :global(.site-author-name) {
    font-size: 1.05rem;
  }

  .profile :global(.site-author-image) {
    border: 0;
  }

  .social-links {
    display: flex;
    gap: 0.5rem;
  }

  .social-links a {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    display: inline-grid;
    place-items: center;
    border: 1px solid light-dark(#aaa59b, #555);
    color: inherit;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    background: light-dark(#111, #f2f0eb);
    color: light-dark(#fff, #111);
  }

  .sidebar-section {
    padding-block: 1.5rem;
    border-block-start: 1px solid light-dark(#c8c3b8, #393939);
  }

  .sidebar-section > :global(.sidebar-heading) {
    margin-block-end: 0.9rem;
  }

  .category-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-list a {
    min-block-size: 2.35rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .category-list small,
  .tag-list small {
    color: currentColor;
    opacity: 0.55;
    font-size: 0.88rem;
  }

  .category-list a:hover span,
  .category-list a:focus-visible span,
  .tag-list a:hover,
  .tag-list a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
  }

  .tag-list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
    font-size: 1rem;
  }

  .sidebar-search :global(form) {
    margin: 0 !important;
  }

  .sidebar-search :global(label) {
    text-align: start !important;
    font-size: 1.1rem !important;
  }

  .sidebar-search :global(input[type="text"]) {
    border-radius: 0;
    font-size: 1.05rem !important;
  }

  .sidebar-search :global(.form-button) {
    margin-inline-start: 0.5em;
    border-radius: 0;
    padding: 0.6rem 0.8rem;
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .editorial-sidebar {
      display: contents;
    }

    .profile,
    .sidebar-section {
      min-inline-size: 0;
      padding: 1rem;
      border-block-start: 1px solid light-dark(#c8c3b8, #393939);
    }

    .profile {
      align-content: start;
    }
  }

  @media (max-width: 580px) {
    .profile,
    .sidebar-section {
      padding-inline: 0;
    }
  }
</style>
