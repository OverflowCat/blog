---
import type { LicenceType, LicencePartType } from "@/scripts/schema/content";
export interface Props {
	parts: LicenceType | LicencePartType[];
}

import LicencePart from "./LicencePart.astro";
const licence = Astro.props.parts;
const parts = Array.isArray(licence) ? licence : licence ? [licence] : licence;
console.log(parts);
---

{
  parts ?
    (
    <h2>版权许可</h2>
    <ol class="licence">
    {
      parts.map(part => (
        typeof part === "string" ? 
        <LicencePart part={{ licence: part, type: "own" }} /> : <LicencePart part={part} />
      ))
    }
    </ol>
  )
: (
  <></>
)
}

<style lang="less" is:global>
  .licence {
    // border: 2px solid #a7a7a7;
    // background-color: #f9f9f9;
    padding: 6px 18px;
    opacity: 0.75;
    // line-height: 150%;
    a {
      color: inherit;
    }
  }
</style>
