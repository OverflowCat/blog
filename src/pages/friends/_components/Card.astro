---
export interface Props {
  id?: string;
  title: string;
  link: string;
  /** RSS 订阅地址 */
  feed: string | false | null;
  avatar: string;
  /** 网站自己的描述 */
  desc?: string;
  /** 网站的基本功能需要 JavaScript 才能正常工作 */
  script?: boolean;
}

const { id, link, title, avatar, desc, feed, script } = Astro.props;
const href = "https://" + link;

import { collect, generateFeedOpml } from "@/scripts/opml";
feed &&
  collect({ title, href: "https://" + href, url: feed, desc: desc ?? "" });
---

<li class="link-card drop-shadow-sm" id={id}>
  <a href={href}>
    <div class="grid-container">
      <div class="title"><h2>{title}</h2></div>
      <img class="avatar" loading="lazy" src={avatar} />
      <div class="link">
        <p id="link">
          <code>{link}</code>
          {feed && <i class="has-feed" />}
          {script && <i class="require-js" />}
        </p>
      </div>
      <div class="main">
        {
          desc ? (
            <>
              <blockquote class="quote" set:html={desc} />
              <div class="comment-both">
                <slot />
              </div>
            </>
          ) : (
            <div class="comment">
              <slot />
            </div>
          )
        }
      </div>
    </div>
  </a>
</li>
<style>
  .has-feed {
    @apply i-mdi:rss inline-block opacity-70 vertical-top;
    transform: translateY(40%);
  }
  .require-js {
    @apply inline-block opacity-0 i-ic:round-javascript;
  }
  .link-card:hover .require-js {
    transform: scale(2) translateY(40%);
    opacity: 0.7;
    transition: opacity 0.6s;
  }
  .link-card {
    text-align: left;
    display: flex;
    padding: 2.5px;
    background-color: white;
    background-image: var(--accent-gradient);
    background-size: 400%;
    border-radius: 0.5rem;
    background-position: 100%;
    transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .link-card > a {
    width: 100%;
    text-decoration: none;
    line-height: 1.4;
    padding: 1rem 1.3rem;
    border-radius: 0.35rem;
    color: #111;
    background-color: white;
    opacity: 0.8;
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
    text-align: left;
    transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  p {
    margin-block-start: 0.5rem;
    margin-block-end: 0;
    color: #444;
  }
  .link-card:is(:hover, :focus-within) {
    background-position: 0;
  }
  .link-card:is(:hover, :focus-within) h2 {
    color: var(--accent);
  }
  img.avatar {
    height: 54px;
    width: 54px;
    border-radius: 50%;
    border: solid #44444466 1px;
  }
  .title {
    grid-area: title;
  }

  .avatar {
    grid-area: avatar;
  }

  .quote {
    text-align: left;
    margin: 0rem;
    background: #f9f9f9;
    border-left: 8px solid #ccc;
    padding-block: 0.2em;
    padding-inline: 6px;
    /* quotes: "\201C""\201D""\2018""\2019"; */
  }

  div.comment-both {
    margin-block-start: 4px;
  }

  div.comment {
    margin-block-start: 16px;
  }

  div.main {
    grid-area: main;
    line-height: 1.8em;
    margin: 0.5em 6px;
  }

  .link {
    grid-area: link;
  }

  .grid-container {
    display: grid;
    grid-template-areas:
      "title title title title avatar"
      "link  link  link  link  avatar"
      "main main main main main"
      "main main main main main"
      "main main main main main";
    gap: 0.35rem;
    padding: 0.1rem;
    justify-content: space-between;
  }

  code {
    font-size: 0.875em;
    font-weight: bold;
    background: rgba(var(--accent), 12%);
    /* color: rgb(var(--accent)); */
    color: var(--accent);
    border-radius: 4px;
    padding: 0.3em 0.45em;
  }
</style>

<style is:raw>
  a {
    border-bottom: none !important;
  }
</style>
