---
import Layout from "@/layouts/Plain.astro";
import Card from "./_components/Card.astro";
import Color from "@/components/Color.astro";
import Stroke from "./_components/Stroke.astro";
import Pn from "@/components/Pn.astro";
import { Code } from "astro:components";
import Bar from "@/templates/Bar.astro";
import "@/styles/monospace.less";
import "@/styles/article.less";
import Conditions from "./conditions.md";

const EXAMPLE = `title: 新世界的大门
href: https://blog.xinshijiededa.men
feed: https://blog.xinshijiededa.men/atom.xml/ # or \`false\`
avatar: # (多种格式可选)
  https://raw.githubusercontent.com/OverflowCat/blog/test_a/imgs/avatar/xni.webp
  https://raw.githubusercontent.com/OverflowCat/blog/test_a/imgs/avatar/xni.svg
  https://raw.githubusercontent.com/OverflowCat/blog/test_a/imgs/avatar/xni.png
  https://avatars.githubusercontent.com/u/20166026?v=4
description: # (多个可选，如果放不下可以用短的)
  zh-hans: 因此幻想是世界，谁若懂得，谁就会歌唱
  en: So fancy is the world, who knows, maybe they sing
  zh-hant: 悟已往之不諫，知來者之可追`;

Astro.locals.noscript = true;
---

