---
export interface Props {
  title: string;
}

import Page from "@templates/zh/Page.astro";
import "@/styles/reset.less";
import "@/styles/article.less";

const { title } = Astro.props;
---

<Page
  lang="zh"
  title={title}
  source="https://github.com/OverflowCat/blog/blame/src/src/pages/friends/index.astro"
>
  <slot />
</Page>

<style>
  * {
    margin: auto;
  }
</style>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
    background-color: #f6f6f6;
  }
  code {
    font-family: Menlo, Monaco, "Lucida Console", "Liberation Mono",
      "DejaVu Sans Mono", "Bitstream Vera Sans Mono", "Fira Code", "FiraCode",
      "FiraCode NF", "Noto Sans Mono", "Noto Sans Mono CJK SC",
      "Noto Sans Mono CJK JP", "Noto Sans Mono CJK KR", "Noto Sans Mono CJK TC",
      "Courier New", monospace;
  }
  @media (min-width: 800px) {
    div.main {
      margin: 0 5%;
    }
  }
</style>
