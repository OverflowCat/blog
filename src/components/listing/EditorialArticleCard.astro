---
import type { CollectionEntry } from "astro:content";
import PhotoImage from "@/components/PhotoImage.astro";
import Icon from "@/components/Icon.astro";
import TelegramBackgroundPattern from "@/components/TelegramBackgroundPattern.astro";
import { getCatSlug } from "@/scripts/tags";
import { resolveThumb } from "@/scripts/photo-resolve";
import "@/styles/manchu.less";
import "@fontsource/noto-sans-mongolian";

export interface Props {
  post: CollectionEntry<"blog">;
  index: number;
}

const { post, index } = Astro.props;
const { data } = post;
const photo = resolveThumb(data);
const icon = data.icon;
const hasPhoto = Boolean(photo && (photo.src || photo.img));

const declared = data.card;
let variant = declared === "landscape" ? "wide" : declared;
if (hasPhoto) {
  if (variant === "wide" || variant === "tall") {
    // keep declared
  } else if (index % 9 === 0) variant = "wide";
  else if (index % 7 === 0) variant = "tall";
  else variant = "standard";
} else {
  if (!variant || !["mini", "text"].includes(variant)) variant = "text";
}

const tone =
  Array.from(post.id).reduce((sum, char) => sum + char.charCodeAt(0), 0) % 4;
const categories = data.categories ?? [];
const dateFormatter = new Intl.DateTimeFormat("zh-CN", { dateStyle: "long" });
const dateLabel = dateFormatter.format(data.date);
const isDaily = post.id.startsWith("daily/");
const dailySeparator = isDaily ? data.title.indexOf(" / ") : -1;
const dailyDate =
  dailySeparator >= 0 ? data.title.slice(0, dailySeparator) : undefined;
const dailyDateLabel = dailyDate
  ? dateFormatter.format(new Date(`${dailyDate}T00:00:00`))
  : undefined;
let displayTitle =
  dailySeparator >= 0 ? data.title.slice(dailySeparator + 3) : data.title;
let seriesTitle: string | undefined;
if (data.series) {
  const seriesSeparator = displayTitle.indexOf("：");
  if (seriesSeparator < 1 || seriesSeparator === displayTitle.length - 1) {
    throw new Error("Invalid title format. Expected 'Series：Main Title'.");
  }
  seriesTitle = displayTitle.slice(0, seriesSeparator);
  displayTitle = displayTitle.slice(seriesSeparator + 1);
}
const isOverlayCard = hasPhoto && (variant === "wide" || variant === "standard");
---

<article
  class:list={[
    "editorial-card",
    `variant-${variant}`,
    `tone-${tone}`,
    { "has-intro": index < 12 },
    { "lang-mnc": data.lang === "mnc" },
    { "has-photo": hasPhoto },
  ]}
  lang={data.lang === "mnc" ? undefined : data.lang}
  style={`--card-order: ${Math.min(index, 10)}; grid-column: span ${variant === "wide" || variant === "standard" ? 2 : 1}; grid-row: span ${variant === "tall" ? 2 : 1};`}
>
  <a href={`/${post.id}/`} transition:name={post.id} transition:animate="initial">
    {
      !hasPhoto && icon && (
        <div class="card-background-pattern">
          <TelegramBackgroundPattern icon={icon} scale={2.2} />
        </div>
      )
    }
    {
      hasPhoto && photo && (
        <div class="card-image">
          <PhotoImage
            image={photo}
            title={data.title}
            widths={[480, 800, 1200]}
            sizes={
              variant === "wide"
                ? "(max-width: 580px) 100vw, 50vw"
                : "(max-width: 580px) 100vw, 25vw"
            }
            loading={index < 6 ? "eager" : "lazy"}
            fetchpriority={index < 3 ? "high" : "auto"}
          />
          {isOverlayCard && (
            <div class="image-meta" lang={data.lang === "mnc" ? "zh" : undefined}>
              <time datetime={dailyDate ?? data.date.toISOString()}>
                {dailyDateLabel ?? dateLabel}
              </time>
              {icon && (
                <span class="image-icon" aria-hidden="true">
                  <Icon name={icon} />
                </span>
              )}
            </div>
          )}
          {
            icon && variant !== "mini" && !isOverlayCard && (
              <span class="image-icon" aria-hidden="true">
                <Icon name={icon} />
              </span>
            )
          }
        </div>
      )
    }
    <div class="card-copy">
      {!isOverlayCard && (
        <div class="card-kicker" lang={data.lang === "mnc" ? "zh" : undefined}>
          {
            (!hasPhoto || variant === "mini") && (
              <span>{categories.length > 0 ? categories[0] : "文章"}</span>
            )
          }
          <time datetime={dailyDate ?? data.date.toISOString()}>
            {dailyDateLabel ?? dateLabel}
          </time>
        </div>
      )}
      {
        icon && hasPhoto && variant === "mini" && (
          <span class="card-icon" aria-hidden="true">
            <Icon name={icon} />
          </span>
        )
      }
      <h2 lang={data.lang}>
        {
          seriesTitle && (
            <span
              class:list={[
                "series-name",
                data.series === "harmony"
                  ? "series-name-harmony"
                  : "series-name-default",
              ]}
            >
              {seriesTitle}
            </span>
          )
        }
        {seriesTitle && " "}
        <span>{displayTitle}</span>
      </h2>
      {
        data.desc && (
          <p
            class:list={{ "write-vertical-right": data.lang === "mnc" }}
            lang={data.lang === "mnc" ? "zh" : undefined}
          >
            {data.desc}
          </p>
        )
      }
    </div>
  </a>
  {
    categories[0] && (
      <a
        class="category-link"
        href={`/categories/${getCatSlug(categories[0])}/`}
        aria-label={`查看分类：${categories[0]}`}
        lang={data.lang === "mnc" ? "zh" : undefined}
      >
        {categories[0]}
      </a>
    )
  }
</article>

<style>
  .editorial-card {
    --card-border: light-dark(#171717, #55524d);
    --card-accent: light-dark(#c92b38, #ef5360);

    position: relative;
    block-size: 100%;
    min-block-size: 0;
    min-inline-size: 0;
    border: 1px solid var(--card-border);
    border-radius: 0;
    background: light-dark(#f7f6f2, #202020);
    color: light-dark(#111, #f4f1eb);
    overflow: hidden;
    content-visibility: auto;
    contain-intrinsic-size: auto 360px;
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }

  .editorial-card::after {
    content: "";
    position: absolute;
    z-index: 3;
    inset: 0;
    border: 3px solid var(--card-accent);
    opacity: 0;
    pointer-events: none;
    transform: scale(0.985);
    transition:
      opacity 180ms ease,
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .editorial-card:hover,
  .editorial-card:focus-within {
    background: light-dark(#fff, #272727);
    border-color: var(--card-accent);
  }

  .editorial-card:hover::after,
  .editorial-card:focus-within::after {
    opacity: 1;
    transform: scale(1);
  }

  .lang-mnc .card-copy {
    flex: 1;
    min-width: 0;
    min-height: 0;
    writing-mode: vertical-lr;
  }

  .lang-mnc h2 {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
    writing-mode: vertical-lr;
    font-feature-settings: "kern" 1, "liga" 1, "calt" 1, "vert" 1;
    text-orientation: sideways;
  }

  .lang-mnc .card-copy > p {
    display: block;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    max-width: 45%;
    max-height: 100%;
    text-orientation: mixed;
    -webkit-line-clamp: unset;
  }

  .lang-mnc.variant-mini .card-copy > p {
    display: none;
  }

  .series-name {
    display: inline-block;
    margin-inline-end: 0.4em;
    border: 1px solid;
    border-radius: 0.375rem;
    padding-block: 0.15em;
    padding-inline: 0.45em;
    font-size: 0.78em;
    font-weight: 700;
    line-height: 1.25;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      text-shadow 180ms ease;
  }

  .series-name-harmony {
    border-color: light-dark(rgb(220 38 38 / 0.16), rgb(248 113 113 / 0.35));
    background: light-dark(rgb(254 242 242 / 0.8), rgb(69 10 10 / 0.72));
    color: light-dark(#dc2626, #fca5a5);
  }

  .series-name-default {
    border-color: light-dark(rgb(22 163 74 / 0.22), rgb(74 222 128 / 0.34));
    background: light-dark(rgb(240 253 244 / 0.8), rgb(5 46 22 / 0.72));
    color: light-dark(#15803d, #86efac);
  }

  .editorial-card:hover .series-name,
  .editorial-card:focus-within .series-name {
    text-shadow: 0 1px 4px currentColor;
  }

  .editorial-card > a:first-child {
    block-size: 100%;
    display: grid;
    grid-template-rows: 42% 1fr;
    color: inherit;
    text-decoration: none;
  }

  .editorial-card:not(.has-photo) > a:first-child,
  .variant-mini > a:first-child {
    position: relative;
    grid-template-rows: minmax(0, 1fr);
  }

  .card-background-pattern {
    position: absolute;
    z-index: 0;
    inset-block: auto 0;
    inset-inline: auto 0;
    inline-size: min(100%, 21rem);
    block-size: 10rem;
    color: var(--card-accent);
    opacity: 0.3;
    pointer-events: none;
    filter: saturate(0.85);
    transition:
      opacity 360ms ease,
      filter 440ms ease;
  }

  .card-background-pattern :global(.tgbg__emoji) {
    transform: translate3d(0, 0, 0) rotate(0) scale(0.96);
    transition: transform var(--tgbg-duration) cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0ms;
  }

  .editorial-card:hover > a:first-child > .card-background-pattern,
  .editorial-card:focus-within > a:first-child > .card-background-pattern {
    opacity: 0.52;
    filter: saturate(1.25);
  }

  .editorial-card:hover
    > a:first-child
    > .card-background-pattern
    :global(.tgbg__emoji),
  .editorial-card:focus-within
    > a:first-child
    > .card-background-pattern
    :global(.tgbg__emoji) {
    transform: translate3d(
        var(--tgbg-spread-x),
        var(--tgbg-spread-y),
        0
      )
      rotate(var(--tgbg-rotate)) scale(1.06);
    transition-delay: var(--tgbg-delay);
  }

  .variant-tall > a:first-child {
    grid-template-rows: 50% 1fr;
  }

  .variant-wide > a:first-child,
  .variant-standard > a:first-child {
    position: relative;
    display: block;
    isolation: isolate;
  }

  .variant-wide .card-image,
  .variant-standard .card-image {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .variant-wide .card-image::after,
  .variant-standard .card-image::after {
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.02) 25%,
      rgb(0 0 0 / 0.38) 62%,
      rgb(0 0 0 / 0.72) 100%
    );
    opacity: 1;
  }

  .variant-wide .card-copy,
  .variant-standard .card-copy {
    position: absolute;
    z-index: 2;
    inset-inline: 0;
    inset-block-end: 0;
    min-block-size: 0;
    padding: clamp(0.8rem, 1.2vw, 1.1rem) clamp(1rem, 2vw, 1.5rem);
    justify-content: flex-end;
    gap: 0.35rem;
    background: light-dark(rgb(255 255 255 / 0.7), rgb(33 33 33 / 0.6));
    color: light-dark(#111, #fff);
    backdrop-filter: blur(8px) saturate(0.82);
    -webkit-backdrop-filter: blur(8px) saturate(0.82);
  }

  .variant-mini {
    min-block-size: 10rem;
  }

  .variant-mini .card-image,
  .variant-mini p {
    display: none;
  }

  .variant-mini h2 {
    font-size: 1.35rem;
  }

  .variant-text {
    min-block-size: 13rem;
  }

  .variant-text .card-copy,
  .variant-mini .card-copy {
    flex: 1;
    justify-content: flex-start;
  }

  .tone-0 {
    --card-accent: light-dark(#385f83, #74a4d1);
  }

  .tone-1 {
    --card-accent: light-dark(#a12632, #ef5360);
  }

  .tone-2 {
    --card-accent: light-dark(#08756d, #58c5ba);
  }

  .tone-3 {
    --card-accent: light-dark(#896400, #e3be54);
  }

  .card-image {
    position: relative;
    min-block-size: 0;
    overflow: hidden;
    background: #111;
  }

  .card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 55%, rgb(0 0 0 / 0.32));
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .image-icon {
    position: absolute;
    z-index: 1;
    inset-inline-end: 0.75rem;
    inset-block-end: 0.75rem;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    display: grid;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.8);
    background: rgb(17 17 17 / 0.82);
    color: #fff;
    font-size: 1.35rem;
    backdrop-filter: blur(8px);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-meta {
    position: absolute;
    z-index: 2;
    inset-block-start: 0.65rem;
    inset-inline-end: 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: #fff;
  }

  .image-meta time {
    border: 1px solid rgb(255 255 255 / 0.72);
    padding: 0.35rem 0.5rem;
    background: rgb(17 17 17 / 0.78);
    font-size: 0.68rem;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .image-meta .image-icon {
    position: static;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    font-size: 1rem;
  }

  .card-image :global(picture),
  .card-image :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .card-image :global(img) {
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-card:hover .card-image :global(img) {
    transform: scale(1.055);
  }

  .editorial-card:hover .card-image::after,
  .editorial-card:focus-within .card-image::after {
    opacity: 1;
  }

  .card-copy {
    position: relative;
    z-index: 1;
    min-block-size: 0;
    min-inline-size: 0;
    padding: clamp(0.75rem, 1.2vw, 1.15rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.75rem;
    overflow: hidden;
  }

  .card-icon {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    flex: none;
    display: grid;
    place-items: center;
    margin-block-start: 0.25rem;
    border: 1px solid currentColor;
    color: currentColor;
    font-size: 1.45rem;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-card:hover .card-icon,
  .editorial-card:focus-within .card-icon,
  .editorial-card:hover .image-icon,
  .editorial-card:focus-within .image-icon {
    background: light-dark(#111, #f4f1eb);
    color: light-dark(#fff, #171717);
    transform: rotate(-7deg) scale(1.08);
  }

  .card-kicker {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: currentColor;
    opacity: 0.66;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .card-kicker span {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-kicker time {
    flex: none;
    white-space: nowrap;
  }

  h2 {
    flex-shrink: 0;
    margin-block: 0.5rem 0;
    color: inherit;
    font-size: 1.55rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: start;
    overflow-wrap: anywhere;
    transition:
      color 180ms ease,
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .variant-wide h2 {
    font-size: 2.25rem;
  }

  .variant-wide p,
  .variant-standard p {
    margin-block-start: 0.15rem;
    opacity: 0.82;
    -webkit-line-clamp: 2;
  }

  .editorial-card:hover h2,
  .editorial-card:focus-within h2 {
    color: var(--card-accent);
    transform: translateY(-0.12rem);
  }

  .variant-wide:hover h2,
  .variant-wide:focus-within h2,
  .variant-standard:hover h2,
  .variant-standard:focus-within h2 {
    color: light-dark(#111, #fff);
  }

  p {
    flex-shrink: 0;
    margin-block-start: 0.5rem;
    color: currentColor;
    opacity: 0.7;
    font-size: 0.9rem;
    line-height: 1.55;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .category-link {
    position: absolute;
    z-index: 4;
    inset-block-start: 0.65rem;
    inset-inline-start: 0.65rem;
    max-inline-size: calc(100% - 1.3rem);
    border-radius: 0;
    padding: 0.35rem 0.5rem;
    overflow: hidden;
    background: #111d;
    color: #fff;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 750;
    line-height: 1;
  }

  .editorial-card:not(.has-photo) .category-link,
  .variant-mini .category-link {
    display: none;
  }

  @container article-list (inline-size <= 580px) {
    .editorial-card {
      block-size: auto;
      min-block-size: 18rem;
    }

    .variant-mini {
      min-block-size: 12rem;
    }

    .variant-tall {
      min-block-size: 30rem;
    }

    .variant-wide h2 {
      font-size: 1.65rem;
    }

    .variant-wide .card-copy,
    .variant-standard .card-copy {
      padding: 0.8rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-card,
    .editorial-card::after,
    .card-image :global(img),
    .card-image::after,
    .card-background-pattern,
    .card-background-pattern :global(.tgbg__emoji),
    .card-icon,
    .image-icon,
    h2 {
      animation: none;
      transition: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .editorial-card.has-intro {
      animation: card-enter 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--card-order) * 38ms);
    }
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(0.85rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
