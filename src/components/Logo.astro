---
import type { Decoration } from "@/scripts/decoration";

export interface Props {
	theme?: "transparent" | "auto";
	decoration?: Decoration;
}

let src = "/new-logo.svg";
const { decoration } = Astro.props;
let inlineSize = "";
if (decoration === "langs") {
	src = "https://tong.xinshijiededa.men/logo-yellow.svg";
	inlineSize = "inline-full overflow-x-clip";
}
---

<div class={`logowrapper relative ${inlineSize} select-none`}>
  <img class="relative z-10" src={src} alt="新世界的大門" id="logo" />
  {decoration === "langs" ? (
    <div class="vert-hide absolute inset-is-0 mbs--24 opacity-30 inline-100vi"> 
        <img src="https://tong.xinshijiededa.men/langs.svg" height="22" alt="typography" id="typography"/>
        <img class="mis" src="https://tong.xinshijiededa.men/langs2.svg" height="22" alt="typography" id="typography"/>
        <img class="mis--120" src="https://tong.xinshijiededa.men/langs2.svg" height="22" alt="typography" id="typography"/>
        <img class="mis--50" src="https://tong.xinshijiededa.men/langs.svg" height="22" alt="typography" id="typography"/>
    </div>
  ) : (
    <div class="vert-hide absolute floating opacity-40" style="inset-block-start: -300px; inset-inline-start: -220px;"> 
      <img src="/decorations/planet.svg" class="rotating" width="450" height="450" alt="planet" id="planet"/>
    </div>
    <i class="i-mdi:satellite-variant absolute inset-bs-0 inset-is-50 w-12! h-12! text-lg opacity-40 hover:opacity-100"></i>
    <i class="i-mdi:satellite-variant absolute inset-bs-20 inset-is-65 w-10! h-10! rotate-90 text-lg opacity-40 hover:opacity-100"></i>
    <i class="floating i-mdi:rocket hover:i-mdi:rocket-launch absolute inset-bs-12 inset-is-25 w-10! h-10! rotate-50 text-lg opacity-40 hover:opacity-100"></i>
  )}
</div>

<style lang="less">
  @keyframes rotating {
    0% {
      rotate: 0deg;
    }
    100% {
      rotate: 360deg;
    }
  }
  @keyframes floating {
    0% {
      translate: 0 0;
    }
    50% {
      translate: 0 9px;
    }
    100% {
      translate: 0 0;
    }
  }
  .rotating {
    animation: rotating 100s ease-in-out infinite;
  }
  .floating {
    animation: floating 8s ease-in-out infinite;
  }
  #logo {
    display: block;
    margin: auto;
    block-size: 72px;
  }
  .logowrapper {
    * {
      transition: opacity 0.2s ease;
    }
  }
</style>
