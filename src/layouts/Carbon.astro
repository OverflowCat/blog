---
import CarbonLayout from "./Carbon.tsx";
import CarbonPaper from "@/components/carbon/CarbonPaper.tsx";
import CarbonComments from "@/components/carbon/CarbonComments.tsx";
import type { Frontmatter } from "@/types";
import { getCatsInfo, getTagsInfo } from "@/scripts/tags";
import slogans from "@/scripts/slogans";
import { pick } from "@/scripts/serendipity";
import { getComments } from "@/scripts/comments";
import { genTocTree, type Heading } from "@/components/98/98.ts";
import "plex-sans-sc-cdn/dist/min.css"; // https://cdn.jsdelivr.net/npm/plex-sans-sc-cdn@1.0.0/dist/min.css

const { frontmatter, headings } = Astro.props;

export type Props = {
	frontmatter?: Frontmatter;
	content?: Frontmatter;
	file: string;
	url: string;
	index?: number;
	headings?: Heading[];
};

// Get random slogan
const lang = "zh-Hans";
const slogan = pick(slogans.filter((s) => s[lang]))?.[lang] || "溢出的猫";
const sloganText = typeof slogan === "string" ? slogan : slogan[0];

// Get category and tag info
const catsInfo = getCatsInfo();
const tagsInfo = getTagsInfo();

const classes = frontmatter?.resizable !== false ? ["resizable"] : [];

// Get comments for this page
const slug = Astro.url.pathname.replace(/^\/|\/$/g, "");
const comments = getComments(slug);

// Generate TOC tree from headings
const tocTree = headings && headings.length > 0 ? genTocTree(headings) : null;
---

<CarbonLayout
	client:load
	frontmatter={frontmatter}
	content={Astro.props.content}
	file={Astro.props.file}
	url={Astro.props.url}
	index={Astro.props.index}
	slogan={sloganText}
	showCommon={!!(frontmatter && Astro.props.url !== "/about")}
	catsInfo={catsInfo}
	tagsInfo={tagsInfo}
	tocTree={tocTree}
>
	<slot />
</CarbonLayout>

<section id="comments">
	<CarbonPaper client:load padding={true} paper={true} classes={classes}>
		<CarbonComments
			client:load
			comments={comments}
			lang={frontmatter?.lang}
			slug={slug}
		/>
	</CarbonPaper>
</section>

<style is:inline is:global lang="less">
	article#post > * > * {
		color-scheme: light dark;
		--font-sans: "IBM Plex Sans SC", "Mi Sans", "Noto Sans",
			"Noto Sans CJK SC", "Plangothic P1", "Plangothic P2", "PingFang SC",
			system-ui, sans-serif;
		--font-sans-en: "IBM Plex Sans", Lato, "PT Sans", "Noto Sans",
			"Open Sans", "Roboto", "Helvetica Neue", Helvetica, Arial,
			sans-serif;
		--font-size-fig: 1.12rem;
	}

	body {
		margin: 0;
		padding: 0;
	}

	section#comments {
		margin-block: 2rem;
	}

	.carbon-layout-content {
		padding: 0;
		min-block-size: 100vh;
		background: var(--cds-background);
	}

	@media (max-width: 672px) {
		.carbon-layout-content {
			padding: 0;
		}
	}
</style>
