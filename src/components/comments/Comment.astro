---
export type Props = {
	comment: TransformedComment & { data: { message?: string } };
};
import { detect } from "digua";
import { deviceIcon, osIcon, browserIcon, type SupportedBrowser } from "@/scripts/ua-icons";
import type { TransformedComment } from "@/scripts/comments";
import Icon from "@/components/Icon.astro";
const { comment } = Astro.props;
const { data } = comment;
const { date } = data;
const reply = data.reply
	? {
			...comment,
			data: {
				id: `${comment.id}r`,
				name: "猫猫",
				date: date,
				message: data.reply,
				email: "",
			},
		}
	: undefined;

const message = data.message ? data.message : comment.rendered?.html;
const ua = data.ua ? detect(data.ua) : null;

let url: URL | undefined = undefined;
if (data.url) {
	try {
		url = new URL(
			data.url.startsWith("http://") || data.url.startsWith("https://")
				? data.url
				: `https://${data.url}`
		);
	} catch (e) {
		console.warn("Invalid URL in comment:", data.url);
	}
}

const browser = browserIcon(ua?.browser as SupportedBrowser ?? "Unknown") ?? "";
---

<li itemprop="comment" id={"comment-" + data.id}>
  <hgroup>
    <h4 itemprop="name">
      {url ? <a href={url} set:text={data.name} /> : data.name}
    </h4>
    &nbsp;
    {
      ua && (
        <span class="ua">
          <Icon name={osIcon(ua.os)} size={14} />
          {ua.os === "OpenHarmony" ? "鸿蒙" : ua.os} {ua.osVersion}
          <Icon name={deviceIcon(ua.device)} size={14} />
        </span>
        <span class="ua">
          {browser &&
            (browser?.startsWith("http") ? (
              <img src={browser} alt={ua.browser} width={14} height={14} />
            ) : (
              <Icon name={browser} size={14} />
            ))}
          {ua.browser} {ua.version}
        </span>
      )
    }
    <a href={`#comment-${data.id}`} class="monospace unset-a">
      <time
        class="monospace"
        datetime={date.toISOString()}
        set:text={date.toLocaleDateString("zh")}
        itemprop="datePublished"
      />
    </a>
  </hgroup>
  <article class="message" set:html={message} />
  {
    reply && (
      <div class="reply">
        <div class="icon">
          <Icon name="mdi:reply" />
        </div>
        <ul>
          <Astro.self comment={reply} />
        </ul>
      </div>
    )
  }
</li>

<style lang="less" is:global>
  span.ua {
    @apply bg-gray-200 m-auto vertical-mid rounded-md m-inline-1 p-inline-1 text-sm;
    svg {
      padding-block-start: 2px;
    }
  }
  .reply {
    margin-block-start: 8px;
    padding-inline: 1em;
    background-color: rgba(0, 0, 0, 0.06);
    display: flex;
    gap: 8px;
    justify-content: center;
    line-height: 1.6;
    h2 {
      margin-block: 1.5rem 0;
      margin-inline: auto;
      text-align: center;
    }
    p {
      margin: 0;
      + p {
        margin-block-start: 0.5em;
      }
    }
    .icon {
      margin: auto;
      min-width: 20px;
      flex: 0 0 auto;
    }
    ul {
      flex: 1;
      list-style: none;
      padding: 0;
      margin: 4px;
    }
  }
</style>

<style lang="less">
  li {
    text-align: left; // reset Chrome's default
    padding-block: 0.6em;
    margin-block: 0.3em;
    & + & {
      border-block-start: 1px solid rgba(0, 0, 0, 0.2);
    }

    .message,
    .message > * {
      font-size: 16px;
      text-align: start;
    }

    hgroup {
      h4 {
        display: inline;
        margin-block: 0.2rem;
      }
      time {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-inline-start: 0.5rem;
        margin-block-end: 0.2rem;
      }
    }
  }
</style>
