---
import type { Decoration } from "@/scripts/decoration";

export interface Props {
  index?: number;
  theme?: "transparent" | "auto";
  lang: "zh-Hans" | "zh-Hant" | "en";
  decoration?: Decoration;
  logo?: boolean;
  mode: {
    theme?: boolean | "auto";
    hant?: boolean;
    vert?: boolean;
  };
  icons?: boolean;
}

import Logo from "@components/Logo.astro";
import slogans from "@scripts/slogans";
import { pick } from "@/scripts/serendipity";
import assert from "node:assert";

import Mode from "@/components/Mode.astro";

// console.log(Astro.url.toString(), Astro.locals);

const items = [
  ["文章", "Home", "/", "icon-pencil", "不含日常"],
  ["归档", "Archives", "/archives", "icon-archive", "包含所有文章"],
  ["友链", "Friends", "/friends", "icon-link"],
  ["订阅", "RSS", "/atom.xml", "icon-rss", "RSS"],
  ["关于", "About", "/about", "icon-frown-o", "自介和本站介绍"],
];
let { index, theme, lang, mode, decoration, icons, logo } = Astro.props;
if (!lang) lang = "zh-Hans";
const slogan = pick(slogans.filter((s) => s[lang]))[lang];
assert(slogan, "slogan is undefined");
---

{
  logo !== false && (
    <nav>
      <div id="logo">
        <Logo theme={theme} decoration={decoration} />
      </div>
      <div
        id="slogan"
        set:text={typeof slogan === "string" ? slogan : slogan[0]}
      />
    </nav>
  )
}
<nav id="sticky" lang="zh">
  <div class="backdrop">
    <div id="small-logo" class="logowrapper edge min-inline-20">
      <img class="logo block block-8 m-1" src="/门-v2z2.svg" alt="logo" />
    </div>
    <ul class="block">
      {
        items.map(async (item, i) => (
          <li
            id={`nav-${i}`}
            class:list={{ "subscription-link": item[2] === "/atom.xml" }}
            transition:name={`navbar-${i}`}
            transition:animate="initial"
          >
            {icons && <i class={item[3]} />}
            <a
              href={item[2]}
              data-replace={index === i ? "本页" : item[0]}
              class={index === i ? "current" : ""}
              title={item.at(4) ?? item[0]}
            >
              <span>{item[0]}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="edge min-inline-20 text-end">
      {
        (
          <Mode
            float={false}
            vert={mode?.vert}
            hant={mode?.hant}
            theme={mode?.theme}
          />
        )
      }
    </div>
  </div>
</nav>
<div id="top-banner" role="status">
  <span>即将换新颜。</span>
</div>
<style lang="less">
  #top-banner {
    @apply z-1000 m-auto inline-full p-block-2 text-center text-3.5;
    &:hover {
      background-color: var(--logo-color, #dd2f3e);
      color: var(--bg-color, #fff);
    }
    font-size: 1.2em;
    span {
      font-weight: 700;
      letter-spacing: 0.1em;
    }
  }
  nav#sticky {
    container-name: navbar;
    container-type: inline-size;
    inline-size: 100%;
    min-inline-size: 0;
    max-inline-size: 36rem;
    @apply z-1000 m-auto min-block-10 inset-bs-2 inset-is-0; // border-rounded-2em border-solid border-2 border-gray-300
    align-items: space-between;
    // backdrop-filter: blur(
      // 15px
    // ); // fallback for browsers not supporting scroll-timeline
    .logo {
      #vert:target & {
        @apply block-7 m-6px;
      }
      animation-timeline: --page-timeline;
      animation-name: navlogo;
      animation-range: 0px 120px;
    }
  }
  @keyframes navblur {
    0% {
      backdrop-filter: blur(0px);
    }
    3% {
      backdrop-filter: blur(0px);
    }
    10% {
      backdrop-filter: blur(12px);
    }
    100% {
      backdrop-filter: blur(15px);
    }
  }
  @keyframes navlogo {
    0% {
      opacity: 0;
    }
    80% {
      opacity: 0;
    }
    97% {
      opacity: 0.6;
    }
    100% {
      opacity: 0.6;
    }
  }
  .backdrop {
    @apply flex justify-center items-start inline-full;
    pointer-events: none;
    * {
      pointer-events: all;
    }
  }
  :root {
    --indicator-size: 0.15em;
  }
  * {
    user-select: none;
  }
  #slogan {
    @apply m-block-2 m-inline-0 relative z-100;
    color: var(--hint-color, #3c3c3c);
  }
  #logo,
  #slogan,
  ul {
    text-align: center;
    place-items: center center;
  }
  #logo {
    @apply pbs-4 pbe-1 p-inline-.5 m-block-0 m-inline-auto;
  }
  ul {
    @apply flex justify-center text-4.5 gap-0 p-0;
    margin-block-start: var(--indicator-size);
    margin-block-end: var(--indicator-size);
  }
  li {
    @apply inline-block text-center;
    font-weight: 700;
  }
  a {
    line-height: 200%;
    @apply inline-block decoration-none;
    outline: none;
    padding-inline-start: 0.7em;
    padding-inline-end: 0.7em;
    color: var(--hint-color, #434343);
    transition: background-color 0.3s ease;
    border-block-end: 2px solid transparent; /* indicator-20250221 */
    &:hover,
    &:focus-visible {
      background-color: var(--bg-dim);
    }
  }

  
  li:has(a:is(:hover, :focus-visible)),
  ul:not(:has(a:is(:hover, :focus-visible))) a.current {
    anchor-name: --indicator;
  }
  ul::before {
    content: "";
    position: absolute;
    block-size: var(--indicator-size);
    background-color: var(--logo-color);
    transition: all 0.3s ease;
    inset-block-start: anchor(--indicator end);
    inset-inline-start: anchor(--indicator start);
    block-size: anchor(--indicator);
    inline-size: anchor-size(--indicator);
  }
  ul:hover::before {
    background-color: #dd2f3eDD;
  }

  @supports (scroll-timeline-name: --page-timeline) and
    (container-type: inline-size) and (not (-webkit-touch-callout: none)) {
    nav#sticky {
      backdrop-filter: none; // overrides the fallback
      @apply sticky pbe-2 inset-bs-0 min-inline-unset max-inline-unset inline-full border-none rounded-none;
    }
    .logo.vert-block {
      display: block;
    }
    .logo-icon {
      display: none !important;
    }
    .backdrop {
      @apply justify-between absolute inset-0 z-0;
      animation-name: navblur;
      animation-timeline: --page-timeline;
      animation-range: 123px 155px;
      animation-fill-mode: both;
      /* Extend backdrop surface to the bottom */
      --extended-by: 250px;
      inset-block-end: calc(-1 * var(--extended-by));
      /* Mask out the part falling outside the nav */
      --cutoff: calc(100% - var(--extended-by));
      -webkit-mask-image: linear-gradient(
        to bottom,
        black 0,
        black var(--cutoff),
        transparent var(--cutoff)
      );
      html#vert:target & {
        // html#vert 而不是直接写 #vert 是为了避免 scoped CSS
        -webkit-mask-image: linear-gradient(
          to left,
          black 0,
          black var(--cutoff),
          transparent var(--cutoff)
        );
      }
      html[lang="mnc"] & {
        -webkit-mask-image: linear-gradient(
          to right,
          black 0,
          black var(--cutoff),
          transparent var(--cutoff)
        );
      }
    }
  }
  @container navbar (max-inline-size: 768px) {
    .separator {
      display: none;
    }
    .edge {
      @apply min-inline-0;
    }
  }
  @container navbar (max-inline-size: 520px) {
    #small-logo {
      display: none;
    }
    a {
      padding-inline-start: 0.5em;
      padding-inline-end: 0.5em;
    }
  }
  @container navbar (max-inline-size: 400px) {
    .subscription-link {
      display: none;
    }
  }
</style>
<style is:raw>
  @container html not (scroll-state(scrollable: block-start)) {
    #small-logo {
      transform: scaleX(0);
      transform-origin: left;
      #vert:target & {
        transform: scaleY(0);
        transform-origin: top;
      }
      transition: all 1s;
    }
  }
  @container html scroll-state(scrollable: block-start) {
    #small-logo {
      transform: scaleX(1);
      transform-origin: left;
      #vert:target & {
        transform: scaleY(1);
        transform-origin: top;
      }
      transition: all 1s;
    }
  }
</style>
